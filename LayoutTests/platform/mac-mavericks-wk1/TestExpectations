# --- Known Web Audio codec limitations on 10.9 (CoreAudio/ExtAudioFile) ----------------------------------
# 10.9's CoreAudio decodes WAV/MP3/AAC but NOT FLAC/Opus/Vorbis, and (unlike modern macOS) does not trim
# AAC encoder-delay "priming" frames. These are real platform limitations, not harness defects. The ones
# that hang decodeAudioData (no error callback) are Skipped to avoid the 30s timeout; the rest fail the
# value comparison. (decodeAudioData migration to GStreamer would lift these — see project task #100.)
webaudio/decode-audio-data-aac.html [ Failure ]
webaudio/decode-audio-data-flac.html [ Failure ]
webaudio/decode-audio-data-mp4-opus.html [ Failure ]
webaudio/decode-audio-data-webm-opus.html [ Failure ]
webaudio/decode-audio-data-webm-opus-resample.html [ Failure ]
webaudio/decode-audio-data-webm-vorbis.html [ Failure ]
webaudio/codec-tests/vorbis [ Skip ]

webaudio/MediaStreamAudioSource/mediastreamaudiosourcenode.html [ Failure ]
