# override. DumpRenderTree turns every experimental feature on, so `window.cookieStore` is present here
# and each of its operations rejects instead -- the suite fails on the interface, not on cookie
# behavior. These run under mac-mavericks-wk2.
imported/w3c/web-platform-tests/cookiestore [ Skip ]

