# MAVERICKS_BACKPORT: WebKit1 (DumpRenderTree) expectations for the macOS 10.9 backport. The port
# drops the suite-wide skips at the top of platform/mac-wk1/TestExpectations (webkitpy/port/mac.py),
# so every suite runs here under the generic, platform/mac and per-test mac-wk1 expectations.
#
# A test that fails is left failing, so a run reports it. The only entries here are [ Skip ] for a
# test nothing in this port could ever make pass, and [ Pass ] where a broader skip is overridden.
# Measured causes for the tests that run red are in MavericksSupport/tests/port-surface/known-failures.md.

# --- Suites and tests this port cannot run -------------------------------------------------------

# File System Access API / OPFS (navigator.storage.getDirectory) is not enabled here.
storage/filesystemaccess [ Skip ]

# window.webkitStorageInfo and window.webkitStorageQuota were removed from the engine, so these
# tests reference an interface no build of this WebKit has.
storage/storageinfo-query-usage.html [ Skip ]
storage/storageinfo-request-quota.html [ Skip ]
storage/storageinfo-no-callbacks.html [ Skip ]
storage/storageinfo-missing-arguments.html [ Skip ]
storage/storagequota-query-usage.html [ Skip ]
storage/storagequota-request-quota.html [ Skip ]

# This test allocates until allocation fails, which drains the primitive Gigacage's reserved region
# for the life of the driver process: the region is handed to pas_reserved_memory_provider once at
# construction and never refilled (null_aligned_allocator, pas_megapage_cache deallocator = NULL), so
# every later size class needing a fresh 16MB megapage fails too, in unrelated tests that run after
# it. Upstream records it as a flaky timeout on mac, ios and gtk (webkit.org/b/227845,
# webkit.org/b/252878).
webaudio/audioworket-out-of-memory.html [ Skip ]

# WebGPU is off at the upstream CMake-port default and 10.9 has no Metal to back it, so navigator.gpu
# is null and every test here ends on a notifyDone that never comes.
http/tests/webgpu [ Skip ]

# These suites drive the upstream frontend: inspector-test.js calls testRunner.showWebInspector(),
# which reaches WKPageShowWebInspectorForTesting -> WebInspectorUIProxy::show() and opens the frontend
# built from Source/WebInspectorUI. This port has no user of that frontend -- Safari 7 opens its own,
# which reaches the same backend agents through WebCore's InspectorFrontendClassicBridge -- so these
# tests exercise a path the port does not run.
inspector [ Skip ]
http/tests/inspector [ Skip ]

# --- Cookies -------------------------------------------------------------------------------------

# Cookie behavior is a backport-critical area (NSHTTPCookieStorage on 10.9 predates SameSite and the
# public-suffix rules), so the WPT cookie suites run here rather than under mac-wk1's blanket
# `imported [ Skip ]`.
imported/w3c/web-platform-tests/cookies [ Pass ]

# 10.9 records a cookie's creation time to the whole second -- CFHTTPCookieGetCreationTime and
# CFHTTPCookieGetCreateDate both answer the same value for cookies made a millisecond apart -- so the
# tie RFC 6265bis 5.5 breaks by creation time among equal-length paths cannot be expressed here. The
# rest of the suite's ordering, which is by path length, passes. Jonathan's call: skipped.
imported/w3c/web-platform-tests/cookies/ordering/ordering.sub.html [ Skip ]

# Upstream skips this test on every port -- LayoutTests/TestExpectations names it [ Skip ], added by the
# same commit that imported it and its baseline -- so no bot has ever verified that baseline, and this
# port runs the test only because of the blanket un-skip above. It cannot pass anywhere: a child frame's
# parse-time postMessage is delivered to the parent AND replayed by testharness.js's getmessages handler,
# so RemoteContext.test_done runs twice per remote test while Tests.push counted it once. num_pending
# reaches zero while the local promise_test is still running, remote_done calls tests.complete(), and
# Tests.complete force-finishes the live test through cleanup_done rather than Test.done -- which leaves
# the provisional "Test timed out" that Test.step stamps in place of PASS.
imported/w3c/web-platform-tests/cookies/partitioned-cookies/partitioned-cookies-a-b-a-embed.tentative.https.html [ Skip ]

# The Cookie Store API is WebKit2-only in upstream WebKit: CookieJar::getCookiesAsync and
# ::setCookieAsync answer failure in WebCore's base class and the only override is WebKit2's
# WebCookieJar, so under WebKit1 every operation rejects with an empty-message TypeError before any
# subtest registers. This file is a cookie test that reaches the API in its prologue.
imported/w3c/web-platform-tests/cookies/partitioned-cookies/partitioned-cookies.tentative.https.html [ Skip ]

# The Cookie Store API is WebKit2-only in upstream WebKit, as above. DumpRenderTree turns every
# experimental feature on, so `window.cookieStore` is present here and each of its operations rejects
# instead -- the suite fails on the interface, not on cookie behavior. These run under
# mac-mavericks-wk2.
imported/w3c/web-platform-tests/cookiestore [ Skip ]
