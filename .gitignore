# CMake-generated Makefiles in build-only subdirs (companions of cmake_install.cmake)
Source/JavaScriptCore/shell/Makefile
Source/ThirdParty/unifdef/Makefile
Source/WTF/wtf/Makefile
Source/WebCore/PAL/pal/Makefile
# Top-level module Makefiles: hand-written upstream wrappers (include ../Makefile.shared),
# but a CMake Unix-Makefiles generation clobbers them with machine-specific generated dumps.
# Keep the upstream versions tracked and ignore local cmake regeneration.
Source/Makefile
Source/WTF/Makefile
Source/WebInspectorUI/Makefile
# IDL preprocessor scratch
Source/WebCore/idl_files_*.tmp
Source/WebCore/included_idl_files_*.tmp
Source/WebCore/pp_idl_files_*.tmp
# Generated headers
Source/WebCore/PAL/pal/PALSwift-Generated.h
# Local backup/scratch (kept locally, never committed)
*.bak
*.stub
*.stub_backup
*.10_9_stub
*.minimal

