# MAVERICKS_BACKPORT: VideoFullscreenManager itself is excluded from the 10.9 build
# (ENABLE_VIDEO_PRESENTATION_MODE is off, so WebProcess/cocoa/VideoFullscreenManager is
# commented out in PlatformMac.cmake). This empty .messages.in placeholder keeps the
# message-generation step satisfied without declaring any actual IPC messages.
[
    DispatchedFrom=UI,
    DispatchedTo=WebContent
]
messages -> VideoFullscreenManager {
}
