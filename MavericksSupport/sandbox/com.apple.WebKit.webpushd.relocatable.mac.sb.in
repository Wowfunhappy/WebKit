; MAVERICKS_BACKPORT: the webpushd sandbox profile for this port.
;
; Unlike the WebContent and Networking profiles next to it, this one has no Mavericks-era
; upstream ancestor to recover -- webpushd postdates 10.9 entirely, so upstream never wrote a
; version of it in this OS's sandbox vocabulary. It is therefore upstream's
; com.apple.WebKit.webpushd.relocatable.mac.sb.in re-expressed in the vocabulary 10.9's
; sandbox compiler accepts: `(import "system.sb")` in place of the open-coded system-path
; preamble modern profiles carry, no file-map-executable / lsopen / *-prefix filters (all
; postdate 10.9), and `(system-network)` for the socket rules. What it grants is the same set
; of capabilities upstream grants, narrowed to what this port's daemon actually does: hold the
; WebSocket to the Mozilla push service, keep the push database, and hand pushes to Safari.
;
; This is the RELOCATABLE profile, which is the one that gets applied: OptionsMac.cmake sets
; ENABLE_RELOCATABLE_WEBPUSHD, so applySandbox() in WebPushDaemonMain.mm looks for
; com.apple.WebKit.webpushd.relocatable.mac.sb and the database is PushDatabase.relocatable.db.
;
; Copyright (C) 2024 Apple Inc. All rights reserved.
;
; Redistribution and use in source and binary forms, with or without
; modification, are permitted provided that the following conditions
; are met:
; 1. Redistributions of source code must retain the above copyright
;    notice, this list of conditions and the following disclaimer.
; 2. Redistributions in binary form must reproduce the above copyright
;    notice, this list of conditions and the following disclaimer in the
;    documentation and/or other materials provided with the distribution.
;
; THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''
; AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
; THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
; PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
; BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
; CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
; SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
; INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
; CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
; ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
; THE POSSIBILITY OF SUCH DAMAGE.

(version 1)
(deny default (with partial-symbolication))
(allow system-audit file-read-metadata)

(import "system.sb")

;; Utility functions for home directory relative path filters
(define (home-regex home-relative-regex)
  (regex (string-append "^" (regex-quote (param "HOME_DIR")) home-relative-regex)))

(define (home-subpath home-relative-subpath)
  (subpath (string-append (param "HOME_DIR") home-relative-subpath)))

(define (home-literal home-relative-literal)
  (literal (string-append (param "HOME_DIR") home-relative-literal)))

;; Read-only preferences and data
(allow file-read*
    (subpath "/Library/Frameworks")
    (subpath "/Library/Managed Preferences")
    (regex #"^/private/etc/(hosts|group|passwd)$")

    (literal "/Library/Preferences/.GlobalPreferences.plist")
    (home-literal "/Library/Preferences/.GlobalPreferences.plist")
    (home-regex #"/Library/Preferences/ByHost/\.GlobalPreferences\.")
    (home-literal "/Library/Preferences/com.apple.LaunchServices.plist")
    (home-literal "/Library/Preferences/com.apple.WebFoundation.plist")
    (home-literal "/.CFUserTextEncoding")

    ;; On-disk WebKit2 framework location, to account for debug installations
    ;; outside of /System/Library/Frameworks
    (subpath (param "WEBKIT2_FRAMEWORK_DIR")))

;; Daemon prefs.
(allow user-preference-read user-preference-write
    (preference-domain "com.apple.webkit.webpushd.relocatable"))

(allow file-read* file-write* (subpath (param "DARWIN_USER_CACHE_DIR")))
(allow file-read* file-write* (subpath (param "DARWIN_USER_TEMP_DIR")))

;; Various services required by CFNetwork and other frameworks
(allow mach-lookup
    (global-name "com.apple.SystemConfiguration.configd")
    (global-name "com.apple.cookied")
    (global-name "com.apple.cfnetwork.AuthBrokerAgent")
    (global-name "com.apple.system.logger")
    (global-name "com.apple.system.notification_center")
    (global-name-regex #"^com.apple.distributed_notifications")
    (global-name "com.apple.CoreServices.coreservicesd"))

;; Handing a push to Safari means asking Launch Services to open it. Upstream spends one operation
;; on this -- (allow lsopen) -- which 10.9's sandbox does not have; its equivalent is reaching the
;; two services Launch Services brokers a launch through. com.apple.ls.boxd is the launch broker,
;; and it is what makes the difference: with launchservicesd alone,
;; -[NSWorkspace launchAppWithBundleIdentifier:] resolves the app and then fails, so a push arriving
;; while Safari is closed would never wake it. Neither service lets this daemon spawn anything
;; itself -- boxd does the launching, which is the point.
(allow mach-lookup
    (global-name "com.apple.coreservices.launchservicesd")
    (global-name "com.apple.ls.boxd"))

;; NOTE: no /Applications grant. webpushd identifies each client by its code-signing identifier, and
;; an earlier version of this port did that by verifying the client's signature from its bundle on
;; disk -- which needed read access to every application on the machine, and which failed under this
;; sandbox in a way that killed Web Push outright (empty identifier, every connection rejected, the
;; client reconnecting forever). codeSigningIdentifier() now asks the kernel via csops(2) instead,
;; which touches no files at all. See Shared/Cocoa/CodeSigning.mm.

;; Security framework: the push connection is a TLS WebSocket, so the daemon has to evaluate the
;; push service's certificate chain.
;;
;; This is deliberately NOT the Security block the WebContent and Networking profiles carry. Those
;; are a browser's: read-WRITE on the user's keychains (upstream annotates that one
;; "FIXME: should be removed when <rdar://problem/10479685> is fixed"), on /private/var/db/mds/system,
;; and a list of security preference domains. A push daemon evaluating one server's certificate needs
;; none of that, and upstream's own current webpushd profile grants no keychain access whatsoever.
;; What is here is read-only and was cut back to what an actual denial demanded: the trust evaluation
;; reads the CSSM module directory and the system trust settings, and talks to the two Security
;; daemons. The root certificates themselves live under /System, which system.sb already covers.
(allow mach-lookup
    (global-name "com.apple.ocspd")
    (global-name "com.apple.SecurityServer"))
;; Each of these was A/B'd out individually against a live handshake, and only what broke without it
;; is here:
;;   - com.apple.security.plist: without it the handshake fails with errSSLXCertChainInvalid (-9807)
;;     and the daemon retries forever. The other three preference domains the browser profiles list
;;     are never read, and are not here.
;;   - /private/var/db/mds: without it the handshake fails and the connection never establishes,
;;     with denials on mds/messages/se_SecurityMessages and mds/system/mdsObject.db. Granting just
;;     those two literals is NOT sufficient -- tested, and the handshake still fails -- so the
;;     subtree stays until someone can show a narrower set that actually works. Read-only either way.
;;   - /Library/Keychains was in the block this started from and is NOT here: dropped it, and the
;;     handshake still completes with zero denials. A push daemon evaluating one server's chain does
;;     not read the user's keychains.
(allow file-read*
    (subpath "/private/var/db/mds")
    (literal "/Library/Preferences/com.apple.security.plist"))
(allow ipc-posix-shm-read* ipc-posix-shm-write-data
    (ipc-posix-name "com.apple.AppleDatabaseChanged"))

(allow file-read-data
    (literal "/dev/autofs_nowait"))

;; Networking: the WebSocket to the push service, and DNS to find it.
(system-network)
(allow network-outbound
    (literal "/private/var/run/mDNSResponder")
    (remote tcp)
    (remote udp))

;; We might need to create ~/Library/WebKit and ~/Library/WebKit/WebPush on a clean install.
(allow file-write-create
    (require-all (vnode-type DIRECTORY) (home-literal "/Library/WebKit"))
    (require-all (vnode-type DIRECTORY) (home-literal "/Library/WebKit/WebPush")))

;; Push database, and the Mozilla push service's own registration state next to it.
(allow file*
    (home-literal "/Library/WebKit/WebPush/PushDatabase.relocatable.db")
    (home-literal "/Library/WebKit/WebPush/PushDatabase.relocatable.db-shm")
    (home-literal "/Library/WebKit/WebPush/PushDatabase.relocatable.db-wal")
    (home-literal "/Library/WebKit/WebPush/PushDatabase.relocatable.db-lock")
    (home-literal "/Library/WebKit/WebPush/PushDatabase.relocatable.db-journal")
    (home-literal "/Library/WebKit/WebPush/MozillaPushService.plist"))

;; Let SQLite open the parent directory of the database for fsync purposes.
(allow file-read* (home-subpath "/Library/WebKit/WebPush"))

(if (defined? 'vnode-type)
    (deny file-write-create (vnode-type SYMLINK)))

;; Reserve a namespace for additional protected extended attributes.
(deny file-read-xattr file-write-xattr (xattr #"^com\.apple\.security\.private\."))
