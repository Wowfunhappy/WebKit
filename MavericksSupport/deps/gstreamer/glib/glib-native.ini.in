; MAVERICKS_BACKPORT meson native file: build glib 2.74 for macOS 10.9 with clang-22 + the 26.1 SDK.
; Used by MavericksSupport/deps/gstreamer/glib/build-glib.sh. The -include compat header neutralizes newer-SDK macros
; at the 10.9 deploy target (see glib-10.9-compat.h). pkg-config is disabled so meson uses the
; pre-fetched subprojects (pcre2/libffi/zlib/proxy-libintl); nm must be llvm-nm (a glib build step
; rejects the CommandLineTools nm's flags).
;
; TEMPLATE: build-glib.sh sed-substitutes @TC@ (clang toolchain dir), @SDK@ (macOS SDK dir) and
; @HERE@ (this glib dir) into the generated glib-native.ini before invoking meson.
[binaries]
c = '@TC@/bin/clang'
cpp = '@TC@/bin/clang++'
objc = '@TC@/bin/clang'
ar = '@TC@/bin/llvm-ar'
strip = '@TC@/bin/llvm-strip'
nm = '@TC@/bin/llvm-nm'
pkg-config = 'false'

[built-in options]
c_args = ['-isysroot', '@SDK@', '-mmacosx-version-min=10.9', '--no-default-config', '-D_DARWIN_C_SOURCE', '-include', '@HERE@/glib-10.9-compat.h', '-Wno-implicit-function-declaration']
c_link_args = ['-isysroot', '@SDK@', '-mmacosx-version-min=10.9']
cpp_args = ['-isysroot', '@SDK@', '-mmacosx-version-min=10.9', '--no-default-config', '-D_DARWIN_C_SOURCE', '-include', '@HERE@/glib-10.9-compat.h']
cpp_link_args = ['-isysroot', '@SDK@', '-mmacosx-version-min=10.9']
objc_args = ['-isysroot', '@SDK@', '-mmacosx-version-min=10.9', '--no-default-config', '-D_DARWIN_C_SOURCE', '-include', '@HERE@/glib-10.9-compat.h', '-Wno-implicit-function-declaration']
objc_link_args = ['-isysroot', '@SDK@', '-mmacosx-version-min=10.9']
