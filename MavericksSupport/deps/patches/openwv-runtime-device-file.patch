+fn device_file_path() -> Option<PathBuf> {
+    let mut info: DlInfo = unsafe { std::mem::zeroed() };
+
+    // SAFETY: any address inside this image identifies it to dladdr(), which
+    // fills `info` with borrowed pointers valid while the image stays loaded.
+    let found = unsafe { dladdr(InitializeCdmModule_4 as *const c_void, &mut info) };
+    if found == 0 || info.dli_fname.is_null() {
+        return None;
+    }
+
+    let library_path = unsafe { CStr::from_ptr(info.dli_fname) };
+    let library_path = std::path::Path::new(std::ffi::OsStr::from_bytes(library_path.to_bytes()));
+    Some(library_path.parent()?.join(CONFIG.widevine_device_file))
+}
