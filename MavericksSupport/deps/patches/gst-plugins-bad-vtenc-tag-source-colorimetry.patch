# MAVERICKS_BACKPORT: vtenc sets the compression session's destination color properties
# (ColorPrimaries/TransferFunction/YCbCrMatrix), which makes VideoToolbox color-match every source
# pixel buffer against them -- which it can only do if the source states what its pixels are. The
# buffers this element wraps around raw GstMemory carry no color attachments at all. Newer
# VideoToolbox infers defaults for an untagged source; OS X 10.9's cannot, and fails EVERY frame with
# kVTInsufficientSourceColorDataErr (-12917), so WebRTC outbound H.264 encodes nothing.
#
# The colorimetry is already known from the negotiated caps and already mapped to CoreVideo constants
# for the session properties. This splits that mapping into gst_vtenc_update_colorimetry(), caches the
# three constants on the instance (they are fixed per negotiated caps, and the mapping warns about
# colorimetry it does not cover -- running it per frame would be log I/O inside a realtime encoder),
# and states them on the buffer handed to VTCompressionSessionEncodeFrame(). The tagging sits at that
# single call site so it covers every path that produces a pixel buffer, including one arriving with a
# core-media meta from avfvideosrc -- the capture path WebRTC actually uses, and the one an
# insertion inside the "if (pbuf == NULL)" branch would miss on macOS.
#
# Color matching then has both ends it needs and succeeds on 10.9, with the destination properties
# left in place, so the encoded stream still carries correct color information.
#
# Applied by build_deps with patch -p1.
--- a/sys/applemedia/vtenc.c	2026-07-08 17:42:39.000000000 -0400
+++ b/sys/applemedia/vtenc.c	2026-07-31 19:52:34.000000000 -0400
@@ -1347,10 +1347,12 @@
   return TRUE;
 }
 
+/* Map the negotiated GstVideoColorimetry onto the CoreVideo image-buffer constants, and cache the
+ * result on the instance. Called once per negotiated caps, never per frame: the mapping warns about
+ * colorimetry it does not cover, which inside a realtime encoder would be log I/O on every frame. */
 static void
-gst_vtenc_set_colorimetry (GstVTEnc * self, VTCompressionSessionRef session)
+gst_vtenc_update_colorimetry (GstVTEnc * self)
 {
-  OSStatus status;
   CFStringRef primaries = NULL, transfer = NULL, matrix = NULL;
   GstVideoColorimetry cm = GST_VIDEO_INFO_COLORIMETRY (&self->video_info);
 
@@ -1442,23 +1444,63 @@
       GST_WARNING_OBJECT (self, "Unsupported color primaries %u", cm.primaries);
   }
 
-  if (primaries) {
+  self->color_primaries = primaries;
+  self->color_transfer = transfer;
+  self->color_matrix = matrix;
+}
+
+/* State on a source pixel buffer what color its pixels are.
+ *
+ * The session's destination color properties below make VideoToolbox color-match every source
+ * buffer against them, which it can only do if the source says what it is. Buffers this element
+ * wraps around raw GstMemory carry no color attachments at all; newer VideoToolbox infers defaults
+ * for an untagged source, OS X 10.9's does not and fails every frame with
+ * kVTInsufficientSourceColorDataErr (-12917). The negotiated caps already told us the colorimetry.
+ *
+ * Applied to every buffer handed to VTCompressionSessionEncodeFrame(), including one that arrived
+ * with a core-media meta: its attachments and our caps describe the same pixels, since the caps
+ * were negotiated from that buffer's own format. */
+static void
+gst_vtenc_attach_colorimetry (GstVTEnc * self, CVPixelBufferRef pbuf)
+{
+  if (self->color_primaries) {
+    CVBufferSetAttachment (pbuf, kCVImageBufferColorPrimariesKey,
+        self->color_primaries, kCVAttachmentMode_ShouldPropagate);
+  }
+  if (self->color_transfer) {
+    CVBufferSetAttachment (pbuf, kCVImageBufferTransferFunctionKey,
+        self->color_transfer, kCVAttachmentMode_ShouldPropagate);
+  }
+  if (self->color_matrix) {
+    CVBufferSetAttachment (pbuf, kCVImageBufferYCbCrMatrixKey,
+        self->color_matrix, kCVAttachmentMode_ShouldPropagate);
+  }
+}
+
+static void
+gst_vtenc_set_colorimetry (GstVTEnc * self, VTCompressionSessionRef session)
+{
+  OSStatus status;
+
+  gst_vtenc_update_colorimetry (self);
+
+  if (self->color_primaries) {
     status = VTSessionSetProperty (session,
-        kVTCompressionPropertyKey_ColorPrimaries, primaries);
+        kVTCompressionPropertyKey_ColorPrimaries, self->color_primaries);
     GST_DEBUG_OBJECT (self, "kVTCompressionPropertyKey_ColorPrimaries =>"
         "%d", status);
   }
 
-  if (transfer) {
+  if (self->color_transfer) {
     status = VTSessionSetProperty (session,
-        kVTCompressionPropertyKey_TransferFunction, transfer);
+        kVTCompressionPropertyKey_TransferFunction, self->color_transfer);
     GST_DEBUG_OBJECT (self, "kVTCompressionPropertyKey_TransferFunction =>"
         "%d", status);
   }
 
-  if (matrix) {
+  if (self->color_matrix) {
     status = VTSessionSetProperty (session,
-        kVTCompressionPropertyKey_YCbCrMatrix, matrix);
+        kVTCompressionPropertyKey_YCbCrMatrix, self->color_matrix);
     GST_DEBUG_OBJECT (self, "kVTCompressionPropertyKey_YCbCrMatrix => %d",
         status);
   }
@@ -2259,6 +2301,8 @@
     g_mutex_unlock (&self->encoding_mutex);
   }
 
+  gst_vtenc_attach_colorimetry (self, pbuf);
+
   vt_status = VTCompressionSessionEncodeFrame (self->session,
       pbuf, ts, duration, frame_props,
       GINT_TO_POINTER (frame->system_frame_number), NULL);
--- a/sys/applemedia/vtenc.h	2026-07-08 17:42:39.000000000 -0400
+++ b/sys/applemedia/vtenc.h	2026-07-31 19:52:34.000000000 -0400
@@ -101,6 +101,11 @@
   gboolean have_field_order;
   GstVideoCodecState *input_state;
   GstVideoInfo video_info;
+  /* Colorimetry of video_info mapped to CoreVideo constants, computed once per negotiated
+   * caps in gst_vtenc_set_colorimetry(). Unowned: these are process-wide CFString constants. */
+  CFStringRef color_primaries;
+  CFStringRef color_transfer;
+  CFStringRef color_matrix;
   VTCompressionSessionRef session;
   CFDictionaryRef keyframe_props;
 
