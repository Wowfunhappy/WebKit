# Push-mode segment seeks retain the source's segment flag and translate their
# completion into TIME after delivering the demuxed samples. The demuxer posts
# its TIME segment-start from the seek handler, before the source's own byte
# segment starts and ends, so the bin reports one segment-done per seek.
# Applied after gst-plugins-good-qtdemux-upstream-stream-tags.patch.

--- a/gst/isomp4/qtdemux.c
+++ b/gst/isomp4/qtdemux.c
@@ -1419,6 +1419,18 @@
   GST_OBJECT_UNLOCK (qtdemux);
 
   qtdemux->segment_seqnum = seqnum;
+
+  /* a push-mode segment seek starts here, in stream time, as it does in the
+   * pull loop: posted before the source runs its own byte segment, so the bin
+   * holds one segment open until this demuxer's segment-done ends it */
+  if (flags & GST_SEEK_FLAG_SEGMENT) {
+    GstMessage *msg = gst_message_new_segment_start (GST_OBJECT_CAST (qtdemux),
+        GST_FORMAT_TIME, cur);
+    if (seqnum != GST_SEQNUM_INVALID)
+      gst_message_set_seqnum (msg, seqnum);
+    gst_element_post_message (GST_ELEMENT_CAST (qtdemux), msg);
+  }
+
   /* BYTE seek event */
   event = gst_event_new_seek (rate, GST_FORMAT_BYTES, flags, cur_type, byte_cur,
       stop_type, stop);
@@ -2426,6 +2438,11 @@
       }
       break;
     }
+    case GST_EVENT_SEGMENT_DONE:
+      if (demux->pullbased || !(demux->segment.flags & GST_SEGMENT_FLAG_SEGMENT))
+        break;
+      /* A byte source segment completes this demuxer's TIME segment. */
+      G_GNUC_FALLTHROUGH;
     case GST_EVENT_EOS:
       /* If we are in push mode, and get an EOS before we've seen any streams,
        * then error out - we have nowhere to send the EOS */
@@ -2446,6 +2463,32 @@
           if (gst_qtdemux_process_adapter (demux, TRUE) != GST_FLOW_OK) {
             res = FALSE;
           }
+
+          /* a push-mode segment seek ends here, in stream time, as it does
+           * in the pull loop */
+          if (demux->segment.flags & GST_SEGMENT_FLAG_SEGMENT) {
+            GstMessage *message;
+            GstEvent *done;
+            gint64 stop;
+
+            if ((stop = demux->segment.stop) == -1)
+              stop = demux->segment.duration;
+            if (GST_CLOCK_TIME_IS_VALID (stop))
+              demux->segment.position = stop;
+
+            GST_LOG_OBJECT (demux, "Sending segment done, at end of segment");
+            message = gst_message_new_segment_done (GST_OBJECT_CAST (demux),
+                GST_FORMAT_TIME, stop);
+            done = gst_event_new_segment_done (GST_FORMAT_TIME, stop);
+            if (demux->segment_seqnum != GST_SEQNUM_INVALID) {
+              gst_message_set_seqnum (message, demux->segment_seqnum);
+              gst_event_set_seqnum (done, demux->segment_seqnum);
+            }
+            gst_element_post_message (GST_ELEMENT_CAST (demux), message);
+            gst_qtdemux_push_event (demux, done);
+            gst_event_unref (event);
+            goto drop;
+          }
         }
       }
       break;
@@ -8971,7 +9014,12 @@
 eos:
   {
     GST_DEBUG_OBJECT (demux, "no next entry, EOS");
-    ret = GST_FLOW_EOS;
+    if (demux->segment.flags & GST_SEGMENT_FLAG_SEGMENT) {
+      /* Consume trailing bytes until the source's segment-done event. */
+      gst_adapter_clear (demux->adapter);
+      ret = GST_FLOW_OK;
+    } else
+      ret = GST_FLOW_EOS;
     goto done;
   }
 invalid_state:
