+/* Download task: applies the variant switch a seek asked for. The switch is
+ * claimed under the manifest lock, so only one task loads it; the current
+ * variant, the one the streams were seeked on, stays until the load succeeds.
+ * A load the cancel ended hands the switch back for the restarted task. */
+static GstFlowReturn
+gst_hls_demux_apply_pending_variant (GstHLSDemux * hlsdemux,
+    GstAdaptiveDemuxStream * stream)
+{
+  GstHLSVariantStream *pending = hlsdemux->pending_variant;
+  guint bitrate = hlsdemux->pending_variant_bitrate;
+  GError *err = NULL;
+  GstFlowReturn ret = GST_FLOW_OK;
+
+  hlsdemux->pending_variant = NULL;
+
+  switch (gst_hls_demux_load_playlist (hlsdemux, pending, stream, &err)) {
+    case GST_HLS_PLAYLIST_UPDATED:
+      gst_hls_demux_set_current_variant (hlsdemux, pending);
+      gst_hls_demux_resync_playlist (hlsdemux, pending->m3u8, FALSE);
+      gst_hls_demux_change_playlist (hlsdemux, bitrate, NULL);
+      break;
+    case GST_HLS_PLAYLIST_SKIPPED:
+    case GST_HLS_PLAYLIST_FAILED:
+      if (gst_hls_demux_download_was_cancelled (err)
+          || gst_hls_demux_download_cancelled (hlsdemux, stream)) {
+        if (hlsdemux->pending_variant == NULL) {
+          hlsdemux->pending_variant = pending;
+          hlsdemux->pending_variant_bitrate = bitrate;
+          pending = NULL;
+        }
+        ret = GST_FLOW_FLUSHING;
+      } else {
+        GST_ELEMENT_ERROR_FROM_ERROR (hlsdemux, "Could not switch playlist",
+            err);
+        ret = GST_FLOW_ERROR;
+      }
+      break;
+  }
+
+  g_clear_error (&err);
+  if (pending)
+    gst_hls_variant_stream_unref (pending);
+  return ret;
+}
