+  if (!gst_adaptive_demux_is_running (GST_ADAPTIVE_DEMUX_CAST (demux)))
+    return TRUE;
+
+  if (stream == NULL)
+    return FALSE;
+
+  g_mutex_lock (&stream->fragment_download_lock);
+  cancelled = stream->cancelled;
+  g_mutex_unlock (&stream->fragment_download_lock);
