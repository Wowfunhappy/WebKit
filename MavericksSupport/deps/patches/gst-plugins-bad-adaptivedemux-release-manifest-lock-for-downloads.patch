+/**
+ * gst_adaptive_demux_manifest_unlock_for_download:
+ * @demux: #GstAdaptiveDemux
+ *
+ * Releases every level of the manifest lock the calling thread holds, so that
+ * a blocking download can run while other threads -- src queries and events,
+ * the updates task, the streams' download tasks -- take the lock. Must be
+ * called by the thread that holds the lock.
+ *
+ * Returns: the depth to pass to gst_adaptive_demux_manifest_relock(). After
+ * re-locking, the caller must treat every piece of shared state as changed:
+ * check gst_adaptive_demux_is_running() and the streams' cancelled flags
+ * before touching anything, as the fragment download path does.
+ */
+gint
+gst_adaptive_demux_manifest_unlock_for_download (GstAdaptiveDemux * demux)
+{
+  gint depth = demux->priv->manifest_lock_depth;
+  gint i;
+
+  for (i = 0; i < depth; i++)
+    GST_MANIFEST_UNLOCK (demux);
+
+  return depth;
+}
+
+/**
+ * gst_adaptive_demux_manifest_relock:
+ * @demux: #GstAdaptiveDemux
+ * @depth: the value gst_adaptive_demux_manifest_unlock_for_download() returned
+ *
+ * Takes the manifest lock back at the depth it was released at.
+ */
+void
+gst_adaptive_demux_manifest_relock (GstAdaptiveDemux * demux, gint depth)
+{
+  gint i;
+
+  for (i = 0; i < depth; i++)
+    GST_MANIFEST_LOCK (demux);
+}
