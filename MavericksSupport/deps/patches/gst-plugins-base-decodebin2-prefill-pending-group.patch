# decodebin sizes a multiqueue that is not posting buffering messages with the
# play-time limits -- five buffers. In a buffering pipeline an adaptive demuxer's
# next variant is built as a pending group whose queue holds everything that group
# will play until the active group has drained, so the switch completes with a
# handful of buffers behind it and the buffering reset that runs at switch
# completion starts the queue in buffering mode near zero: a burst of
# low-percentage buffering messages follows every variant switch, and an
# application that follows the buffering contract pauses playback on them.
#
# A group that is not its chain's active group now takes the buffering limits when
# its queue moves to playing mode. The active group's non-posting queues keep the
# play-time limits, which in a buffering pipeline bound neither time nor bytes.
#
# Applied by build_deps with patch -p1.

--- a/gst/playback/gstdecodebin2.c
+++ b/gst/playback/gstdecodebin2.c
@@ -296,7 +296,7 @@
     GstCaps * caps, GstDecodeBin * decode_bin);
 
 static void decodebin_set_queue_size (GstDecodeBin * dbin,
-    GstElement * multiqueue, gboolean preroll, gboolean seekable);
+    GstDecodeGroup * group, gboolean preroll, gboolean seekable);
 static void decodebin_set_queue_size_full (GstDecodeBin * dbin,
     GstElement * multiqueue, gboolean use_buffering, gboolean preroll,
     gboolean seekable);
@@ -3150,7 +3150,7 @@
    * we can probably set its buffering state to playing now */
   GST_DEBUG_OBJECT (group->dbin, "Setting group %p multiqueue to "
       "'playing' buffering mode", group);
-  decodebin_set_queue_size (group->dbin, group->multiqueue, FALSE,
+  decodebin_set_queue_size (group->dbin, group, FALSE,
       (group->parent ? group->parent->seekable : TRUE));
   CHAIN_MUTEX_UNLOCK (chain);
 
@@ -3599,7 +3599,7 @@
    * we can probably set its buffering state to playing now */
   GST_DEBUG_OBJECT (group->dbin, "Setting group %p multiqueue to "
       "'playing' buffering mode", group);
-  decodebin_set_queue_size (group->dbin, group->multiqueue, FALSE,
+  decodebin_set_queue_size (group->dbin, group, FALSE,
       (group->parent ? group->parent->seekable : TRUE));
 
   /* FIXME: We should make sure that everything gets exposed now
@@ -3797,16 +3797,23 @@
 }
 
 static void
-decodebin_set_queue_size (GstDecodeBin * dbin, GstElement * multiqueue,
+decodebin_set_queue_size (GstDecodeBin * dbin, GstDecodeGroup * group,
     gboolean preroll, gboolean seekable)
 {
   gboolean use_buffering;
 
   /* get the current config from the multiqueue */
-  g_object_get (multiqueue, "use-buffering", &use_buffering, NULL);
+  g_object_get (group->multiqueue, "use-buffering", &use_buffering, NULL);
 
-  decodebin_set_queue_size_full (dbin, multiqueue, use_buffering, preroll,
-      seekable);
+  /* A pending group of a buffering pipeline takes the buffering limits: its
+   * queue holds everything the group will play until the active group has
+   * drained, and buffering is reset onto it when the switch completes. */
+  if (dbin->use_buffering && group->parent
+      && group->parent->active_group != group)
+    use_buffering = TRUE;
+
+  decodebin_set_queue_size_full (dbin, group->multiqueue, use_buffering,
+      preroll, seekable);
 }
 
 /* configure queue sizes, this depends on the buffering method and if we are
