+/* Microseconds from @from to @to */
+static gboolean
+date_difference (GstDateTime * to, GstDateTime * from, GTimeSpan * difference)
+{
+  GDateTime *to_date = gst_date_time_to_g_date_time (to);
+  GDateTime *from_date = gst_date_time_to_g_date_time (from);
+  gboolean result = to_date && from_date;
+
+  if (result)
+    *difference = g_date_time_difference (to_date, from_date);
+  if (to_date)
+    g_date_time_unref (to_date);
+  if (from_date)
+    g_date_time_unref (from_date);
+  return result;
+}
