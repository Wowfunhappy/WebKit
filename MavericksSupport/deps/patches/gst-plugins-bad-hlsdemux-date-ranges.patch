+/**
+ * gst_m3u8_get_date_ranges:
+ *
+ * Describes the EXT-X-DATERANGE tags of the media playlist as an "hls-date-ranges" structure whose
+ * "ranges" array holds one "date-range" structure per tag: "id", "start" and "duration" in stream
+ * time (GST_CLOCK_TIME_NONE for a range that has no end yet), and its X- client "attributes". A
+ * range's stream time is its START-DATE relative to the EXT-X-PROGRAM-DATE-TIME of the fragments;
+ * without a program date-time it starts at the beginning of the stream.
+ *
+ * Returns: (transfer full) (nullable): the structure, or %NULL without any range
+ */
+GstStructure *
+gst_m3u8_get_date_ranges (GstM3U8 * self)
+{
+  GstClockTime anchor_position = GST_CLOCK_TIME_NONE, position;
+  GstDateTime *anchor_date = NULL;
+  GValue ranges = G_VALUE_INIT;
+  GstStructure *result;
+  GList *walk;
+
+  GST_M3U8_LOCK (self);
+  if (!self->date_ranges) {
+    GST_M3U8_UNLOCK (self);
+    return NULL;
+  }
+
+  g_value_init (&ranges, GST_TYPE_ARRAY);
+  for (walk = self->date_ranges; walk; walk = walk->next) {
+    GstM3U8DateRange *range = walk->data;
+    GstClockTime start = 0, duration = GST_CLOCK_TIME_NONE;
+    GTimeSpan difference;
+    GstStructure *entry;
+    GValue value = G_VALUE_INIT;
+    GList *file;
+
+    /* The last fragment with a program date-time at or before the range's start */
+    anchor_date = NULL;
+    anchor_position = GST_CLOCK_TIME_NONE;
+    position = GST_CLOCK_TIME_IS_VALID (self->first_file_start) ?
+        self->first_file_start : 0;
+    for (file = self->files; file; file = file->next) {
+      GstM3U8MediaFile *media_file = file->data;
+
+      if (media_file->program_dt) {
+        if (!anchor_date || (date_difference (range->start_date,
+                    media_file->program_dt, &difference) && difference >= 0)) {
+          anchor_date = media_file->program_dt;
+          anchor_position = position;
+        }
+      }
+      position += media_file->duration;
+    }
+    if (anchor_date && date_difference (range->start_date, anchor_date,
+            &difference)) {
+      gint64 stream_start = (gint64) anchor_position + difference * GST_USECOND;
+      start = stream_start > 0 ? (GstClockTime) stream_start : 0;
+    }
+
+    if (GST_CLOCK_TIME_IS_VALID (range->duration)) {
+      duration = range->duration;
+    } else if (range->end_date && date_difference (range->end_date,
+            range->start_date, &difference) && difference >= 0) {
+      duration = difference * GST_USECOND;
+    } else if (range->end_on_next) {
+      GList *later;
+      GTimeSpan nearest = G_MAXINT64;
+
+      for (later = self->date_ranges; later; later = later->next) {
+        GstM3U8DateRange *other = later->data;
+        if (other != range && !g_strcmp0 (other->class_name, range->class_name)
+            && date_difference (other->start_date, range->start_date,
+                &difference) && difference > 0 && difference < nearest)
+          nearest = difference;
+      }
+      if (nearest != G_MAXINT64)
+        duration = nearest * GST_USECOND;
+    }
+
+    entry = gst_structure_new ("date-range", "id", G_TYPE_STRING, range->id,
+        "start", G_TYPE_UINT64, start, "duration", G_TYPE_UINT64, duration,
+        "attributes", GST_TYPE_STRUCTURE, range->attributes, NULL);
+    if (range->class_name)
+      gst_structure_set (entry, "class", G_TYPE_STRING, range->class_name,
+          NULL);
+    g_value_init (&value, GST_TYPE_STRUCTURE);
+    g_value_take_boxed (&value, entry);
+    gst_value_array_append_and_take_value (&ranges, &value);
+  }
+  GST_M3U8_UNLOCK (self);
+
+  result = gst_structure_new_empty ("hls-date-ranges");
+  gst_structure_take_value (result, "ranges", &ranges);
+  return result;
+}
