+/* Parses the attribute list of an EXT-X-DATERANGE tag (RFC 8216bis 4.4.5.1). ID and START-DATE are
+ * required. */
+static GstM3U8DateRange *
+gst_m3u8_date_range_parse (gchar * data)
+{
+  GstM3U8DateRange *range = g_new0 (GstM3U8DateRange, 1);
+  gchar *a, *v;
+
+  range->duration = GST_CLOCK_TIME_NONE;
+  range->planned_duration = GST_CLOCK_TIME_NONE;
+  range->attributes = gst_structure_new_empty ("attributes");
+
+  while (data && parse_attributes (&data, &a, &v)) {
+    if (g_str_equal (a, "ID")) {
+      g_free (range->id);
+      range->id = gst_m3u8_unquote (v);
+    } else if (g_str_equal (a, "CLASS")) {
+      g_free (range->class_name);
+      range->class_name = gst_m3u8_unquote (v);
+    } else if (g_str_equal (a, "START-DATE") || g_str_equal (a, "END-DATE")) {
+      gchar *date_string = gst_m3u8_unquote (v);
+      GstDateTime *date = gst_date_time_new_from_iso8601_string (date_string);
+      GstDateTime **target = g_str_equal (a, "START-DATE") ?
+          &range->start_date : &range->end_date;
+
+      g_free (date_string);
+      if (*target)
+        gst_date_time_unref (*target);
+      *target = date;
+    } else if (g_str_equal (a, "DURATION")
+        || g_str_equal (a, "PLANNED-DURATION")) {
+      gdouble seconds = g_ascii_strtod (v, NULL);
+
+      if (seconds >= 0 && seconds < (gdouble) (G_MAXUINT64 / GST_SECOND)) {
+        GstClockTime value = (GstClockTime) (seconds * GST_SECOND);
+        if (g_str_equal (a, "DURATION"))
+          range->duration = value;
+        else
+          range->planned_duration = value;
+      }
+    } else if (g_str_equal (a, "END-ON-NEXT")) {
+      range->end_on_next = g_ascii_strcasecmp (v, "YES") == 0;
+    } else if (g_str_has_prefix (a, "X-")) {
+      gchar *value = gst_m3u8_unquote (v);
+      gst_structure_set (range->attributes, a, G_TYPE_STRING, value, NULL);
+      g_free (value);
+    }
+  }
+
+  if (!range->id || !range->start_date
+      || !gst_date_time_has_second (range->start_date)) {
+    GST_WARNING ("EXT-X-DATERANGE without a valid ID and START-DATE");
+    gst_m3u8_date_range_free (range);
+    return NULL;
+  }
+  if (range->end_date && !gst_date_time_has_second (range->end_date)) {
+    gst_date_time_unref (range->end_date);
+    range->end_date = NULL;
+  }
+  return range;
+}
