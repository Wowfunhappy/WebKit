+/* An ISO/IEC 23008-12 image sequence carries its samples in a track whose media handler is
+ * 'pict' rather than 'vide'. Everything below the handler is an ordinary video track: a
+ * VideoMediaHeaderBox in 'minf' and a VisualSampleEntry ('hvc1', 'avc1', ...) in 'stsd'. The
+ * brand is what says the file is one, so the handler is only reinterpreted for a file that
+ * declares 'msf1' (ISO/IEC 23008-12 clause 7).
+ */
+static gboolean
+qtdemux_is_image_sequence (GstQTDemux * qtdemux)
+{
+  GstMapInfo map;
+  gsize i;
+  gboolean found;
+
+  if (qtdemux->major_brand == FOURCC_msf1)
+    return TRUE;
+  if (!qtdemux->comp_brands)
+    return FALSE;
+  if (!gst_buffer_map (qtdemux->comp_brands, &map, GST_MAP_READ))
+    return FALSE;
+  found = FALSE;
+  for (i = 0; i + 4 <= map.size; i += 4) {
+    if (QT_FOURCC (map.data + i) == FOURCC_msf1) {
+      found = TRUE;
+      break;
+    }
+  }
+  gst_buffer_unmap (qtdemux->comp_brands, &map);
+  return found;
+}
+
 /* parse the traks.
  * With each track we associate a new QtDemuxStream that contains all the info
  * about the trak.
@@ -15052,6 +15082,8 @@
   len = QT_UINT32 ((guint8 *) hdlr->data);
