# qtdemux drops the stream tags an upstream element sends before its source pads exist: the
# sink event handler hands a TAG event to gst_pad_event_default, which forwards it to the pads
# the element has so far, and a demuxer fed by an adaptive demuxer receives its stream's tags
# together with the first fragment, before the moov has been parsed and any pad exposed. The
# title and language an HLS rendition declares in its manifest arrive that way, so an fMP4
# rendition's audio track loses them.
#
# Stream-scoped upstream tags describe every stream of the container. They are kept and merged
# under each stream's own tags when those are pushed, the way GstBaseParse and GstAudioDecoder
# merge upstream stream tags under the tags they produce, and cleared on a new stream-start,
# as those elements clear theirs. Tags already pushed are re-sent merged when new upstream tags
# arrive.
#
# An adaptive demuxer carrying a rendition inside the container's own stream sends that
# rendition's tags in a sticky "hls-rendition-tags" event: one tag list per stream type (audio,
# video, text). Each list is merged into the tags of this container's streams of that type,
# replacing the container's values, and cleared with the upstream tags. hlsdemux sends that
# event for a rendition with its own fragments too, so the manifest's title and language win over
# the container's for every rendition.
#
# When the upstream stream-start carries a GstStream, qtdemux puts one on its own stream-start as
# well: this stream's type, caps and flags, with its tags under the upstream stream's and the
# rendition tags of its type over both.
#
# A "<type>-default" field in that event marks a DEFAULT rendition carried inside the container:
# this container's stream of that type is announced with GST_STREAM_FLAG_SELECT.
#
# Applied by build_deps with patch -p1.
--- a/gst/isomp4/qtdemux.h
+++ b/gst/isomp4/qtdemux.h
@@ -172,6 +172,14 @@
 
   GstTagList *tag_list;
 
+  /* Stream-scoped tags received from upstream, which describe every stream of this container.
+   * They are merged under each stream's own tags when those are pushed. */
+  GstTagList *upstream_tags;
+
+  /* The "hls-rendition-tags" an adaptive demuxer sends for renditions carried inside this
+   * container: one tag list per stream type, merged into the streams of that type. */
+  GstStructure *rendition_tags;
+
   /* configured playback region. Note that this is a seek segment, not to be
    * confused with an edit list segment. Seeks are done for global time (i.e.
    * with edit lists applied). */
--- a/gst/isomp4/qtdemux.c
+++ b/gst/isomp4/qtdemux.c
@@ -500,6 +500,8 @@
 
   g_clear_object (&qtdemux->adapter);
   gst_clear_tag_list (&qtdemux->tag_list);
+  gst_clear_tag_list (&qtdemux->upstream_tags);
+  gst_clear_structure (&qtdemux->rendition_tags);
   g_clear_pointer (&qtdemux->flowcombiner, gst_flow_combiner_unref);
 
   g_queue_clear_full (&qtdemux->protection_event_queue,
@@ -805,6 +807,27 @@
   return res;
 }
 
+/* The field of an "hls-rendition-tags" event for a stream's type, and the GstStreamType of it */
+static const gchar *
+qtdemux_stream_type_field (QtDemuxStream * stream, GstStreamType * type)
+{
+  if (stream->subtype == FOURCC_soun) {
+    *type = GST_STREAM_TYPE_AUDIO;
+    return "audio";
+  }
+  if (stream->subtype == FOURCC_vide) {
+    *type = GST_STREAM_TYPE_VIDEO;
+    return "video";
+  }
+  if (stream->subtype == FOURCC_text || stream->subtype == FOURCC_sbtl ||
+      stream->subtype == FOURCC_subp || stream->subtype == FOURCC_wvtt) {
+    *type = GST_STREAM_TYPE_TEXT;
+    return "text";
+  }
+  *type = GST_STREAM_TYPE_UNKNOWN;
+  return NULL;
+}
