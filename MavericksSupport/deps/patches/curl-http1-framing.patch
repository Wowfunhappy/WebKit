+/* A field line carries a colon (RFC 9112 section 5). A line that starts with a
+   blank continues the field line before it, where the caller allows folding.
+   Anything else is not part of the field section. */
+bool Curl_header_is_field_line(const char *hd, size_t hdlen, bool folds)
+{
+  if(folds && ISBLANK(*hd))
+    return TRUE;
+  return !!memchr(hd, ':', hdlen);
+}
