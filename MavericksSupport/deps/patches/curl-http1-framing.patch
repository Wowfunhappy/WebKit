+/* RFC 9112 section 7.1.1. Parse ignored extensions incrementally so arbitrary
+ * bytes after the hexadecimal size cannot turn an invalid size into a chunk. */
+static bool chunk_token(unsigned char c)
+{
+  return ISALNUM(c) || (c && strchr("!#$%&'*+-.^_`|~", c));
+}
+
+static bool chunk_extension(struct Curl_chunker *ch, unsigned char c)
+{
+  switch(ch->state) {
+  case CHUNK_EXT:
+  case CHUNK_EXT_NAME_END:
+  case CHUNK_EXT_VALUE_END:
+    if(ISBLANK(c))
+      return TRUE;
+    if(c == ';')
+      ch->state = CHUNK_EXT_NAME_START;
+    else if(c == '\r')
+      ch->state = CHUNK_LF;
+    else if(c == '=' && ch->state == CHUNK_EXT_NAME_END)
+      ch->state = CHUNK_EXT_VALUE_START;
+    else
+      return FALSE;
+    return TRUE;
+  case CHUNK_EXT_NAME_START:
+    if(ISBLANK(c))
+      return TRUE;
+    if(!chunk_token(c))
+      return FALSE;
+    ch->state = CHUNK_EXT_NAME;
+    return TRUE;
+  case CHUNK_EXT_NAME:
+    if(chunk_token(c))
+      return TRUE;
+    ch->state = CHUNK_EXT_NAME_END;
+    return chunk_extension(ch, c);
+  case CHUNK_EXT_VALUE_START:
+    if(ISBLANK(c))
+      return TRUE;
+    if(c == '"')
+      ch->state = CHUNK_EXT_QUOTED;
+    else if(chunk_token(c))
+      ch->state = CHUNK_EXT_VALUE;
+    else
+      return FALSE;
+    return TRUE;
+  case CHUNK_EXT_VALUE:
+    if(chunk_token(c))
+      return TRUE;
+    ch->state = CHUNK_EXT_VALUE_END;
+    return chunk_extension(ch, c);
+  case CHUNK_EXT_QUOTED:
+    if(c == '"')
+      ch->state = CHUNK_EXT_VALUE_END;
+    else if(c == '\\')
+      ch->state = CHUNK_EXT_ESCAPED;
+    else if(!(c == '\t' || c == ' ' || c == '!' ||
+              (c >= '#' && c <= '[') || (c >= ']' && c <= '~') || c >= 128))
+      return FALSE;
+    return TRUE;
+  case CHUNK_EXT_ESCAPED:
+    if(!(c == '\t' || c == ' ' || (c >= '!' && c <= '~') || c >= 128))
+      return FALSE;
+    ch->state = CHUNK_EXT_QUOTED;
+    return TRUE;
+  default:
+    return FALSE;
+  }
+}
