# MAVERICKS_BACKPORT: webrtcbin 1.28's _validate_ice_attr (ext/webrtc/webrtcsdp.c) rejects a
# remote ice-ufrag/ice-pwd whose characters fall outside RFC 5245/8839's ice-char set
# (ALPHA/DIGIT/'+'/'/'). Real browsers (libwebrtc) emit base64/base64url credentials
# containing '-'/'_'/'=' and do NOT validate the charset of the REMOTE credential, so this
# strict check breaks set-remote-description for e.g. Google Meet (the call never starts:
# EndCause 19). Drop the charset validation, keeping only the length bounds, to match
# libwebrtc. Applied by build_deps with patch -p1.
--- a/ext/webrtc/webrtcsdp.c	2026-07-08 23:16:51.000000000 -0400
+++ b/ext/webrtc/webrtcsdp.c	2026-07-08 23:16:51.000000000 -0400
@@ -227,8 +227,13 @@
     return FALSE;
 
   for (guint i = 0; i < len; i++) {
-    if (!g_ascii_isalnum (attr[i]) && attr[i] != '+' && attr[i] != '/')
-      return FALSE;
+    /* MAVERICKS_BACKPORT: do not charset-validate the remote ICE credential. RFC 5245/8839's
+     * ice-char set is ALPHA/DIGIT/'+'/'/', but real browsers (libwebrtc) emit base64/base64url
+     * ice-ufrag/ice-pwd containing '-'/'_'/'=' and, crucially, do NOT validate the charset of
+     * the REMOTE credential. webrtcbin 1.28's strict check rejects them, breaking interop with
+     * e.g. Google Meet (set-remote-description fails -> the call never starts). Keep only the
+     * length bounds above, matching libwebrtc. */
+    (void) attr[i];
   }
   return TRUE;
 }
