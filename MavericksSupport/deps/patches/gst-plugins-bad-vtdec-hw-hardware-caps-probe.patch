# vtdec_hw inherits vtdec's sink pad template, which advertises every codec whether or not the
# machine can hardware-decode it. VTDecompressionSessionCreate with
# kVTVideoDecoderSpecification_RequireHardwareAcceleratedVideoDecoder answers -8973 (10.9's legacy
# spelling of kVTCouldNotFindVideoDecoderErr) on a machine with no hardware decoder for the codec --
# any VM, and H.264-only-era Macs asked for HEVC.
#
# The template is what every caller that does not instantiate the element reads: the registry
# serves it to capability queries, decodebin builds its factory list from it, and WebKit's
# GStreamerRegistryScanner picks a decoder factory out of it -- preferring the "Hardware" klass,
# which is vtdec_hw at rank primary+1, above avdec_h264. ImageDecoderGStreamer then creates that
# factory and links its harness pad straight into the decoder's sink pad, with no accept-caps
# fallback: on a machine with no hardware decoder the link answers GST_PAD_LINK_NOFORMAT and the
# first buffer push returns GST_FLOW_NOT_LINKED, so an mp4 loaded as an image decodes no frames at
# all. Through decodebin3 the same lie surfaces later and harder: its candidate window closes after
# a caps-less READY->PAUSED succeeds, so vtdec_hw's set_format error passes through unfiltered and
# kills every MSE, blob and mediastream pipeline playbin3 builds.
#
# The patch gives vtdec_hw its own sink template, carrying only the codecs a RequireHardware
# decompression session can actually be created for, probed once per codec type with a bare
# CMVideoFormatDescription -- session creation resolves the decoder from the codec type alone, and
# measured on a hardware-decode-less 10.9 machine the software session for the same bare
# description succeeds (noErr) while RequireHardware answers -8973. A status that names the decoder
# missing settles the question and is cached; one that reports it busy or malfunctioning
# (kVTVideoDecoderNotAvailableNowErr, kVTVideoDecoderMalfunctionErr, which vtdec's own decode path
# treats as a session restart) describes this instant rather than the machine, so the codec keeps
# its caps and the next query asks again.
#
# With the codec gone from the template, template readers select the next factory (avdec_h264) and
# decodebin3's accept-caps check fails inside its candidate window. On machines whose VideoToolbox
# does hardware-decode the codec, the probe succeeds and vtdec_hw keeps its caps, rank and hardware
# path.
#
# Applied by build_deps with patch -p1.
--- a/sys/applemedia/vtdec.c
+++ b/sys/applemedia/vtdec.c
@@ -2127,6 +2127,136 @@
   return av1_supported;
 }
 
+/* 10.9's VideoToolbox reports a missing decoder with a legacy codec-not-found
+ * value as well as the named one. */
+#define GST_VTDEC_COULD_NOT_FIND_VIDEO_DECODER        ((OSStatus) -12906)
+#define GST_VTDEC_COULD_NOT_FIND_VIDEO_DECODER_LEGACY ((OSStatus) -8973)
+
+/* Whether this machine's VideoToolbox can create a hardware-only decompression
+ * session for the codec. A bare format description (no codec data) is enough
+ * for the availability answer: session creation resolves the decoder from the
+ * codec type alone. A machine with no hardware decoder for the codec answers a
+ * codec-not-found status while a software session for the same bare description
+ * succeeds. That answer is cached per codec type; a status reporting the decoder
+ * busy or malfunctioning describes this instant rather than the machine, so it
+ * is neither cached nor treated as absence. */
+static void
+gst_vtdec_hw_probe_output_cb (void *user_data, void *source_frame_ref_con,
+    OSStatus status, VTDecodeInfoFlags info_flags,
+    CVImageBufferRef image_buffer, CMTime pts, CMTime duration)
+{
+}
+
+static gboolean
+gst_vtdec_hw_supports_codec_type (CMVideoCodecType cm_format)
+{
+  static GMutex probe_lock;
+  static GHashTable *probe_results;
+  gpointer cached;
+  gboolean found, supported = FALSE;
+  CMFormatDescriptionRef desc = NULL;
+
+  g_mutex_lock (&probe_lock);
+  if (!probe_results)
+    probe_results = g_hash_table_new (g_direct_hash, g_direct_equal);
+  found = g_hash_table_lookup_extended (probe_results,
+      GINT_TO_POINTER (cm_format), NULL, &cached);
+  g_mutex_unlock (&probe_lock);
+  if (found)
+    return GPOINTER_TO_INT (cached);
+
+  if (CMVideoFormatDescriptionCreate (NULL, cm_format, 1920, 1080, NULL,
+          &desc) == noErr) {
+    CFMutableDictionaryRef spec = CFDictionaryCreateMutable (NULL, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    VTDecompressionOutputCallbackRecord callback =
+        { gst_vtdec_hw_probe_output_cb, NULL };
+    VTDecompressionSessionRef session = NULL;
+    OSStatus status;
+
+    gst_vtutil_dict_set_boolean (spec,
+        kVTVideoDecoderSpecification_EnableHardwareAcceleratedVideoDecoder,
+        TRUE);
+    gst_vtutil_dict_set_boolean (spec,
+        kVTVideoDecoderSpecification_RequireHardwareAcceleratedVideoDecoder,
+        TRUE);
+    status = VTDecompressionSessionCreate (NULL, desc, spec, NULL, &callback,
+        &session);
+    if (session) {
+      VTDecompressionSessionInvalidate (session);
+      CFRelease (session);
+    }
+    CFRelease (spec);
+    CFRelease (desc);
+
+    if (status != noErr
+        && status != GST_VTDEC_COULD_NOT_FIND_VIDEO_DECODER
+        && status != GST_VTDEC_COULD_NOT_FIND_VIDEO_DECODER_LEGACY) {
+      GST_INFO ("a hardware session for codec type %" G_GINT32_FORMAT
+          " answered %d, which does not report the decoder absent",
+          (gint32) cm_format, (int) status);
+      return TRUE;
+    }
+
+    supported = (status == noErr);
+  }
+
+  g_mutex_lock (&probe_lock);
+  g_hash_table_insert (probe_results, GINT_TO_POINTER (cm_format),
+      GINT_TO_POINTER (supported));
+  g_mutex_unlock (&probe_lock);
+
+  return supported;
+}
+
+/* The codec type to probe hardware availability with for a sink-template
+ * structure. ProRes uses 422 as the representative variant: hardware ProRes is
+ * all-or-nothing per machine. VP9 and AV1 return 0 -- vtdec's getcaps gates
+ * those on VTIsHardwareDecodeSupported. */
+static CMVideoCodecType
+gst_vtdec_hw_probe_codec_type (const GstStructure * s)
+{
+  const gchar *name = gst_structure_get_name (s);
+
+  if (!strcmp (name, "video/x-h264"))
+    return kCMVideoCodecType_H264;
+  if (!strcmp (name, "video/x-h265"))
+    return kCMVideoCodecType_HEVC;
+  if (!strcmp (name, "video/mpeg"))
+    return kCMVideoCodecType_MPEG2Video;
+  if (!strcmp (name, "image/jpeg"))
+    return kCMVideoCodecType_JPEG;
+  if (!strcmp (name, "video/x-prores"))
+    return kCMVideoCodecType_AppleProRes422;
+  return 0;
+}
+
+/* The sink-template codecs this machine's VideoToolbox can hardware-decode. */
+static GstCaps *
+gst_vtdec_hw_supported_sink_caps (void)
+{
+  GstCaps *caps =
+      gst_caps_make_writable (gst_static_caps_get
+      (&gst_vtdec_sink_template.static_caps));
+  guint n = gst_caps_get_size (caps);
+
+  for (guint i = 0; i < n;) {
+    GstStructure *s = gst_caps_get_structure (caps, i);
+    CMVideoCodecType cm_format = gst_vtdec_hw_probe_codec_type (s);
+
+    if (cm_format != 0 && !gst_vtdec_hw_supports_codec_type (cm_format)) {
+      GST_INFO ("this machine has no hardware decoder for %s, removing it from "
+          "the vtdec_hw sink template", gst_structure_get_name (s));
+      gst_caps_remove_structure (caps, i);
+      n--;
+    } else {
+      i++;
+    }
+  }
+
+  return caps;
+}
+
 static GstCaps *
 gst_vtdec_getcaps (GstVideoDecoder * decoder, GstCaps * filter)
 {
@@ -2282,12 +2412,26 @@
 static void
 gst_vtdec_hw_class_init (GstVtdecHwClass * klass)
 {
-  gst_element_class_set_static_metadata (GST_ELEMENT_CLASS (klass),
+  GstElementClass *element_class = GST_ELEMENT_CLASS (klass);
+  GstCaps *sinkcaps;
+
+  gst_element_class_set_static_metadata (element_class,
       "Apple VideoToolbox decoder (hardware only)",
       "Codec/Decoder/Video/Hardware",
       "Apple VideoToolbox Decoder",
       "Ole André Vadla Ravnås <oleavr@soundrop.com>; "
       "Alessandro Decina <alessandro.d@gmail.com>");
+
+  /* The template inherited from GstVtdec is what the registry serves to
+   * capability queries, to the auto-plugger's factory list and to
+   * gst_pad_link, and a hardware-only decoder on a machine whose VideoToolbox
+   * cannot open a hardware session for the codec decodes none of it. This
+   * template carries the codecs this machine backs, so a caller reading it
+   * selects a decoder that works instead of this one. */
+  sinkcaps = gst_vtdec_hw_supported_sink_caps ();
+  gst_element_class_add_pad_template (element_class,
+      gst_pad_template_new ("sink", GST_PAD_SINK, GST_PAD_ALWAYS, sinkcaps));
+  gst_caps_unref (sinkcaps);
 }
 
 static void
