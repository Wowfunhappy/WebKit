+typedef struct
+{
+  QtDemuxStream *stream;
+  GstBuffer *buffer;
+  guint64 dts, pts, duration;
+  gboolean round_up_duration;
+  gboolean keyframe;
+  guint64 byte_position;
+  GstClockTime time;
+  guint fragment_serial;
+} QtDemuxHeldSample;
+
+static gboolean
+qtdemux_stream_is_interleaved (QtDemuxStream * stream)
+{
+  return stream->pad && stream->stsd_entries && !CUR_STREAM (stream)->sparse;
+}
+
+/* Push mode sends a fragment's samples in the order their bytes arrive, and a
+ * fragment may store each stream's samples as one run. With an upstream
+ * delivering timed fragments and more than one non-sparse stream, samples are
+ * held and sent in decode-time order, as the pull loop sends them. */
+static gboolean
+gst_qtdemux_holds_samples (GstQTDemux * demux)
+{
+  guint i, interleaved = 0;
+
+  if (demux->pullbased || !demux->fragmented || !demux->upstream_format_is_time
+      || demux->variant == VARIANT_MSE_BYTESTREAM || demux->segment.rate < 0)
+    return FALSE;
+
+  for (i = 0; i < QTDEMUX_N_STREAMS (demux); i++) {
+    if (qtdemux_stream_is_interleaved (QTDEMUX_NTH_STREAM (demux, i)))
+      interleaved++;
+  }
+  return interleaved > 1;
+}
+
+static void
+qtdemux_held_sample_free (QtDemuxHeldSample * held)
+{
+  if (held->buffer)
+    gst_buffer_unref (held->buffer);
+  held->stream->n_held_samples--;
+  gst_qtdemux_stream_unref (held->stream);
+  g_free (held);
+}
+
+/* keeps samples of equal time in the order they were held */
+static gint
+qtdemux_held_sample_compare (gconstpointer queued, gconstpointer added,
+    gpointer user_data)
+{
+  const QtDemuxHeldSample *a = queued, *b = added;
+
+  return a->time <= b->time ? -1 : 1;
+}
+
+static void
+gst_qtdemux_hold_sample (GstQTDemux * demux, QtDemuxStream * stream,
+    GstBuffer * buffer, guint64 dts, guint64 pts, guint64 duration,
+    gboolean round_up_duration, gboolean keyframe, guint64 byte_position)
+{
+  QtDemuxHeldSample *held = g_new0 (QtDemuxHeldSample, 1);
+
+  held->stream = gst_qtdemux_stream_ref (stream);
+  held->buffer = buffer;
+  held->dts = dts;
+  held->pts = pts;
+  held->duration = duration;
+  held->round_up_duration = round_up_duration;
+  held->keyframe = keyframe;
+  held->byte_position = byte_position;
+  held->time = QTSTREAMTIME_TO_GSTTIME (stream, dts);
+  held->fragment_serial = demux->fragment_serial;
+  stream->n_held_samples++;
+  g_queue_insert_sorted (&demux->held_samples, held,
+      qtdemux_held_sample_compare, NULL);
+}
+
+/* TRUE while another non-sparse stream can still provide a sample that decodes
+ * before @held within the fragment @held was taken from. A track's samples come
+ * in decode order and each run continues where the previous one ended, so a
+ * stream judged by its next parsed sample, or by the end of the samples parsed
+ * for it, has nothing earlier to come once that point is not before @held.
+ * Once upstream delivers the next timed fragment, the fragment @held came from
+ * is complete: a stream whose data in it did not reach @held has a gap there,
+ * and @held is sent. */
+static gboolean
+qtdemux_held_sample_waits (GstQTDemux * demux, QtDemuxHeldSample * held)
+{
+  gint i;
+
+  if (held->fragment_serial != demux->fragment_serial)
+    return FALSE;
+
+  for (i = 0; i < QTDEMUX_N_STREAMS (demux); i++) {
+    QtDemuxStream *stream = QTDEMUX_NTH_STREAM (demux, i);
+    QtDemuxSample *sample;
+    guint32 next;
+
+    if (stream == held->stream || !qtdemux_stream_is_interleaved (stream)
+        || stream->sent_eos || STREAM_IS_EOS (stream))
+      continue;
+    /* its earliest held sample is at or after @held in the queue */
+    if (stream->n_held_samples)
+      continue;
+
+    /* a stream whose sample table a new [moof] replaced starts at its first
+     * sample, which sample_index records as -1 */
+    next = stream->sample_index == G_MAXUINT32 ? 0 : stream->sample_index;
+    if (next < stream->n_samples) {
+      sample = &stream->samples[next];
+      if (QTSTREAMTIME_TO_GSTTIME (stream, sample->timestamp) < held->time)
+        return TRUE;
+      continue;
+    }
+
+    if (stream->n_samples) {
+      sample = &stream->samples[stream->n_samples - 1];
+      if (QTSTREAMTIME_TO_GSTTIME (stream,
+              sample->timestamp + sample->duration) >= held->time)
+        continue;
+    }
+
+    return TRUE;
+  }
+
+  return FALSE;
+}
+
+/* Sends held samples that nothing can precede any more, or all of them. */
+static GstFlowReturn
+gst_qtdemux_release_held_samples (GstQTDemux * demux, gboolean all)
+{
+  GstFlowReturn ret = GST_FLOW_OK;
+  QtDemuxHeldSample *held;
+
+  while ((held = g_queue_peek_head (&demux->held_samples))) {
+    GstFlowReturn flow;
+    GstBuffer *buffer;
+
+    if (!all && qtdemux_held_sample_waits (demux, held))
+      break;
+
+    g_queue_pop_head (&demux->held_samples);
+    buffer = held->buffer;
+    held->buffer = NULL;
+    flow = gst_qtdemux_decorate_and_push_buffer (demux, held->stream, buffer,
+        held->dts, held->pts, held->duration, held->round_up_duration,
+        held->keyframe, held->dts, held->byte_position);
+    GST_OBJECT_LOCK (demux);
+    flow = gst_qtdemux_combine_flows (demux, held->stream, flow);
+    GST_OBJECT_UNLOCK (demux);
+    qtdemux_held_sample_free (held);
+
+    if (flow != GST_FLOW_OK) {
+      ret = flow;
+      if (flow != GST_FLOW_NOT_LINKED)
+        break;
+    }
+  }
+
+  return ret;
+}
+
+static void
+gst_qtdemux_drop_held_samples (GstQTDemux * demux)
+{
+  QtDemuxHeldSample *held;
+
+  while ((held = g_queue_pop_head (&demux->held_samples)))
+    qtdemux_held_sample_free (held);
+}
