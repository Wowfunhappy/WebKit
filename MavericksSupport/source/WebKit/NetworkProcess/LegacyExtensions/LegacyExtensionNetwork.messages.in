# The webRequest events Safari 7 extensions listen to, the extraInfoSpec options their listeners ask for
# ("<event>:<option>"), and the filter of each blocking listener: a JSON object mapping an event name to an
# array of {extension, urls, types, tabId}.
[
    DispatchedFrom=UI,
    DispatchedTo=Networking,
    ExceptionForEnabledBy
]
messages -> LegacyExtensionNetwork {
    SetListeners(Vector<String> observedEvents, Vector<String> listenerOptions, String blockingListeners)
}
