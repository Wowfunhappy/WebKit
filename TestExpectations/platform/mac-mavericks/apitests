# +[NSFont menuFontOfSize:0] is .LucidaGrandeUI 13 on 10.9, in which "abcdef…uvwxyz" measures 101.5625 pt, wider than
# the 100 pt limit; upstream's expected truncation assumes the modern system font.
TestWebKitAPI.WebKitLegacy.StringTruncator [ Skip ]

# Maintainer decision (no web content decodes in ImageIO): these compare the WebView's icon with ImageIO's decode of
# the same PNG. WebCore decodes it with libpng, applying its gAMA chunk as upstream's non-CG decoder does, and builds
# the NSImage from the decoded frames rather than a TIFF parsed by ImageIO.
TestWebKitAPI.WebKitLegacy.IconLoadingDelegateDefaultFirst [ Skip ]
TestWebKitAPI.WebKitLegacy.IconLoadingDelegateCustomFirst [ Skip ]
