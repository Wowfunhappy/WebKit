+static gboolean
+same_mpeg_audio_kind (const GstStructure * a, const GstStructure * b)
+{
+  gint a_version = 0, b_version = 0;
+
+  if (!gst_structure_has_name (a, "audio/mpeg"))
+    return TRUE;
+  gst_structure_get_int (a, "mpegversion", &a_version);
+  gst_structure_get_int (b, "mpegversion", &b_version);
+  return (a_version == 1) == (b_version == 1);
+}
+
+/* Whether two sets of CODECS caps name the same media types (video/x-h265,
+ * audio/mpeg, ...), MPEG audio of the same kind (MPEG-1 or MPEG-2/4): those the
+ * parsers plugged for one take. Codecs not known are not the same. */
+gboolean
+hls_caps_have_same_media_types (const GstCaps * a, const GstCaps * b)
+{
+  guint i, j;
+
+  if (a == NULL || b == NULL
+      || gst_caps_get_size (a) != gst_caps_get_size (b))
+    return FALSE;
+
+  for (i = 0; i < gst_caps_get_size (a); i++) {
+    const GstStructure *sa = gst_caps_get_structure (a, i);
+    gboolean found = FALSE;
+
+    for (j = 0; !found && j < gst_caps_get_size (b); j++) {
+      const GstStructure *sb = gst_caps_get_structure (b, j);
+
+      found = gst_structure_has_name (sb, gst_structure_get_name (sa))
+          && same_mpeg_audio_kind (sa, sb);
+    }
+    if (!found)
+      return FALSE;
+  }
+  return TRUE;
+}
