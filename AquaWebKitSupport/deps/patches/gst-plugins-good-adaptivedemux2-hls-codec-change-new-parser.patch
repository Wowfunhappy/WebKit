+/**
+ * gst_adaptive_demux2_stream_reset_parser:
+ *
+ * Has the stream's next download go to a new parsebin, as its codecs change:
+ * the parser and demuxer elements the current one plugged take only the codecs
+ * they were plugged for. The new parsebin's pads take over the stream's tracks.
+ */
+void
+gst_adaptive_demux2_stream_reset_parser (GstAdaptiveDemux2Stream * stream)
+{
+  GST_DEBUG_OBJECT (stream, "The next download goes to a new parsebin");
+  stream->reset_parser = TRUE;
+}
+
+/* must be called from the scheduler context, between downloads */
+static void
+gst_adaptive_demux2_stream_remove_parser (GstAdaptiveDemux2Stream * stream)
+{
+  GstElement *parsebin = stream->parsebin;
+
+  GST_LOG_OBJECT (stream, "Removing parsebin");
+
+  /* Its pads go, and with them any a track still has pending */
+  gst_element_set_state (parsebin, GST_STATE_NULL);
+  g_signal_handler_disconnect (parsebin, stream->pad_added_id);
+  g_signal_handler_disconnect (parsebin, stream->pad_removed_id);
+  stream->pad_added_id = stream->pad_removed_id = 0;
+  gst_clear_object (&stream->parsebin_sink);
+  gst_bin_remove (GST_BIN_CAST (stream->demux), parsebin);
+  gst_object_unref (parsebin);
+  stream->parsebin = NULL;
+}
