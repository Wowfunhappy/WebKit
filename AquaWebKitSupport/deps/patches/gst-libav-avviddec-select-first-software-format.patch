+/* FFmpeg lists the pixel formats it can produce for the stream, hardware
+ * formats first and software formats last, and a decoder able to produce a
+ * richer software format lists it ahead of the plain one: for an HEVC stream
+ * carrying an alpha layer the decoder offers yuva420p before yuv420p, and
+ * decodes the alpha layer only when the caller selects the alpha format.
+ * avcodec_default_get_format() selects the last software format, so it never
+ * opts in. This selects the first software format, as the ffmpeg tool does
+ * (fftools/ffmpeg_dec.c, get_format()); a stream offering one software format
+ * gets that format. */
+static enum AVPixelFormat
+gst_ffmpegviddec_get_format (AVCodecContext * context,
+    const enum AVPixelFormat * fmts)
+{
+  GstFFMpegVidDec *ffmpegdec = GST_FFMPEGVIDDEC (context->opaque);
+  const enum AVPixelFormat *p;
+
+  for (p = fmts; *p != AV_PIX_FMT_NONE; p++) {
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get (*p);
+
+    if (desc && !(desc->flags & AV_PIX_FMT_FLAG_HWACCEL))
+      break;
+  }
+
+  GST_DEBUG_OBJECT (ffmpegdec, "selected output pixel format %s",
+      av_get_pix_fmt_name (*p));
+
+  return *p;
+}
+
 /* The ffmpeg documentation for get_buffer2() states:
  * "Some decoders do not support linesizes changing between frames."
  * For some well known decoders we know that they can. */
@@ -1203,8 +1244,38 @@
      */
     create_buffer_flags = AV_BUFFER_FLAG_READONLY;
   }
-  picture->buf[0] = av_buffer_create (NULL,
-      0, dummy_free_buffer, dframe, create_buffer_flags);
+  /* libavcodec's get_buffer2() contract has every data[] pointer of the frame
+   * contained in one of its buf[] references, one per allocated chunk, and
+   * libavcodec finds a plane's buffer through them: the hevc decoder points an
+   * alpha-layer frame's luma plane at the base frame's alpha plane that way.
+   * One reference per plane, each holding the mapped frame through a shared
+   * parent, is the shape libavcodec's own allocator produces. */
+  {
+    const GstVideoFormatInfo *finfo = dframe->vframe.info.finfo;
+    AVBufferRef *frame_ref = av_buffer_create (NULL, 0, dummy_free_buffer,
+        dframe, create_buffer_flags);
+    guint n_planes = GST_VIDEO_FRAME_N_PLANES (&dframe->vframe);
+
+    if (!frame_ref)
+      goto alloc_failed;
+
+    for (c = 0; c < n_planes; c++) {
+      gint comps[GST_VIDEO_MAX_COMPONENTS];
+      gsize size;
+
+      gst_video_format_info_component (finfo, c, comps);
+      size = (gsize) GST_VIDEO_FRAME_PLANE_STRIDE (&dframe->vframe, c) *
+          GST_VIDEO_FORMAT_INFO_SCALE_HEIGHT (finfo, comps[0],
+          GST_VIDEO_FRAME_HEIGHT (&dframe->vframe));
+      picture->buf[c] = av_buffer_create (picture->data[c], size,
+          plane_free_buffer, av_buffer_ref (frame_ref), create_buffer_flags);
+      if (!picture->buf[c]) {
+        av_buffer_unref (&frame_ref);
+        goto alloc_failed;
+      }
+    }
+    av_buffer_unref (&frame_ref);
+  }
 
   GST_LOG_OBJECT (ffmpegdec, "returned frame %p", dframe->buffer);
 
