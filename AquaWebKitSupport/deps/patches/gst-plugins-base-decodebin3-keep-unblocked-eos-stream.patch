# decodebin3 removes an input stream that has reached EOS when its inputs are unblocked. An input
# unblocks again whenever another input linked to the same collection sees its first buffer, so a
# stream that already delivered all its data and EOS before then is removed with its slot, and a later
# flush never reaches its output. See patches/README.md.
--- a/gst/playback/gstdecodebin3.c	2026-10-20 04:04:59.000000000 -0400
+++ b/gst/playback/gstdecodebin3.c	2026-10-20 04:04:59.000000000 -0400
@@ -1219,6 +1219,7 @@
   while (tmp != NULL) {
     DecodebinInputStream *input_stream = (DecodebinInputStream *) tmp->data;
     GList *next = tmp->next;
+    gboolean was_blocked;
 
     if (input_stream->input != input) {
       tmp = next;
@@ -1233,6 +1234,10 @@
     /* Ensure the stream is linked to a slot */
     gst_decodebin_input_link_to_slot (input_stream);
 
+    /* Only a stream that reached EOS while still blocked, before any data of
+     * its collection flowed, is removed: any other keeps its slot, so its EOS
+     * and later flushes reach its output */
+    was_blocked = input_stream->buffer_probe_id != 0;
     if (input_stream->buffer_probe_id) {
       GST_DEBUG_OBJECT (dbin,
           "Removing pad block on input %p pad %" GST_PTR_FORMAT, input_stream,
@@ -1242,7 +1247,7 @@
       input_stream->buffer_probe_id = 0;
     }
 
-    if (input_stream->saw_eos) {
+    if (input_stream->saw_eos && was_blocked) {
       GST_DEBUG_OBJECT (dbin, "Removing EOS'd stream");
       remove_input_stream (dbin, input_stream);
       tmp = dbin->input_streams;
