+/* WebVTT fragments of a subtitle rendition carry cue times on their own timeline, tied to the
+ * presentation by an X-TIMESTAMP-MAP header. The conversion below is hlsdemux2's
+ * (ext/adaptivedemux2/hls/gsthlsdemux-util.c), reading that map and rewriting each cue timing
+ * line into stream time. */
+
+#define MPEGTIME_TO_GSTTIME(t) (((t) * (guint64) 100000) / 9)
+#define MPEG_TS_MAX_PTS (((((guint64) 1) << 33) * (guint64) 100000) / 9)
+
+#define WEBVTT_TIME_FORMAT "02u:%02u:%02u.%03u"
+#define WEBVTT_TIME_ARGS(t)                       \
+  (guint) ((t) / (GST_SECOND * 60 * 60)),         \
+  (guint) ((t) / (GST_SECOND * 60) % 60),         \
+  (guint) ((t) / GST_SECOND % 60),                \
+  (guint) ((t) / GST_MSECOND % 1000)
+
+static gboolean
+webvtt_next_uint64 (GstByteReader * br, guint64 * out)
+{
+  guint64 value = 0;
+  gboolean res = FALSE;
+
+  while (gst_byte_reader_get_remaining (br)) {
+    guint8 d = gst_byte_reader_peek_uint8_unchecked (br);
+
+    if (g_ascii_isdigit (d)) {
+      value = value * 10 + (d - '0');
+      res = TRUE;
+    } else if (d != ' ' && d != '\t') {
+      break;
+    }
+    gst_byte_reader_skip_unchecked (br, 1);
+  }
+
+  if (res)
+    *out = value;
+
+  return res;
+}
+
+static gboolean
+webvtt_next_uint (GstByteReader * br, guint * out)
+{
+  guint value = 0;
+  gboolean res = FALSE;
+
+  while (gst_byte_reader_get_remaining (br)) {
+    guint8 d = gst_byte_reader_peek_uint8_unchecked (br);
+
+    if (g_ascii_isdigit (d)) {
+      value = value * 10 + (d - '0');
+      res = TRUE;
+    } else if (d != ' ' && d != '\t') {
+      break;
+    }
+    gst_byte_reader_skip_unchecked (br, 1);
+  }
+
+  if (res)
+    *out = value;
+
+  return res;
+}
+
+static gboolean
+webvtt_parse_time (GstByteReader * br, GstClockTime * t,
+    const gchar ** remainder)
+{
+  GstClockTime val = 0;
+  gboolean res = FALSE;
+
+  while (!res && gst_byte_reader_get_remaining (br)) {
+    guint numval;
+    if (webvtt_next_uint (br, &numval)) {
+      guint8 next = gst_byte_reader_peek_uint8_unchecked (br);
+
+      if (next == ':' || next == '.') {
+        /* value was hours, minutes or seconds */
+        val = val * 60 + numval;
+        gst_byte_reader_skip (br, 1);
+      } else {
+        /* Reached the milliseconds, convert to GstClockTime */
+        val = val * GST_SECOND + numval * GST_MSECOND;
+        res = TRUE;
+      }
+    }
+  }
+
+  if (res) {
+    *t = val;
+    if (remainder) {
+      if (gst_byte_reader_get_remaining (br))
+        *remainder = (const gchar *) gst_byte_reader_peek_data_unchecked (br);
+      else
+        *remainder = NULL;
+    }
+  }
+
+  return res;
+}
+
+static inline void
+webvtt_skipwhitespace (GstByteReader * br)
+{
+  while (gst_byte_reader_get_remaining (br)) {
+    guint8 d = gst_byte_reader_peek_uint8_unchecked (br);
+    if (d != ' ' && d != '\t')
+      return;
+    gst_byte_reader_skip_unchecked (br, 1);
+  }
+}
+
+/* Returns TRUE if br starts with str, skipping any spaces/tabs before and after it */
+static gboolean
+webvtt_startswith (GstByteReader * br, const gchar * str, gboolean skip_ws)
+{
+  guint len = strlen (str);
+  const guint8 *data;
+
+  if (skip_ws)
+    webvtt_skipwhitespace (br);
+  if (!gst_byte_reader_peek_data (br, len, &data))
+    return FALSE;
+  if (strncmp ((gchar *) data, str, len))
+    return FALSE;
+  gst_byte_reader_skip_unchecked (br, len);
+  if (skip_ws)
+    webvtt_skipwhitespace (br);
+
+  return TRUE;
+}
+
+static gboolean
+webvtt_read_x_timestamp_map (gchar * data, GstClockTime * local,
+    GstClockTime * mpegts)
+{
+  GstByteReader br;
+
+  gst_byte_reader_init (&br, (guint8 *) data, strlen (data));
+
+  if (!webvtt_startswith (&br, "X-TIMESTAMP-MAP=", FALSE))
+    return FALSE;
+
+  if (webvtt_startswith (&br, "MPEGTS:", TRUE)) {
+    if (!webvtt_next_uint64 (&br, mpegts))
+      return FALSE;
+    *mpegts = MPEGTIME_TO_GSTTIME (*mpegts);
+    if (!webvtt_startswith (&br, ",", TRUE))
+      return FALSE;
+    if (!webvtt_startswith (&br, "LOCAL:", TRUE))
+      return FALSE;
+    if (!webvtt_parse_time (&br, local, NULL))
+      return FALSE;
+  } else if (webvtt_startswith (&br, "LOCAL:", TRUE)) {
+    if (!webvtt_parse_time (&br, local, NULL))
+      return FALSE;
+    if (!webvtt_startswith (&br, ",", TRUE))
+      return FALSE;
+    if (!webvtt_startswith (&br, "MPEGTS:", TRUE))
+      return FALSE;
+    if (!webvtt_next_uint64 (&br, mpegts))
+      return FALSE;
+    *mpegts = MPEGTIME_TO_GSTTIME (*mpegts);
+  } else {
+    return FALSE;
+  }
+
+  GST_DEBUG ("local time:%" GST_TIME_FORMAT ", mpegts time:%" GST_TIME_FORMAT,
+      GST_TIME_ARGS (*local), GST_TIME_ARGS (*mpegts));
+
+  return TRUE;
+}
+
+static gboolean
+webvtt_process_cue_timing_setting_line (const gchar * input,
+    GstClockTime * start, GstClockTime * stop, const gchar ** cue_settings)
+{
+  GstByteReader br;
+
+  gst_byte_reader_init (&br, (guint8 *) input, strlen (input));
+
+  if (!webvtt_parse_time (&br, start, NULL))
+    return FALSE;
+
+  if (gst_byte_reader_get_remaining (&br) < 12 ||
+      g_ascii_strncasecmp ((const gchar *)
+          gst_byte_reader_peek_data_unchecked (&br), "-->", 3))
+    return FALSE;
+
+  gst_byte_reader_skip (&br, 4);
+
+  if (!webvtt_parse_time (&br, stop, cue_settings))
+    return FALSE;
+
+  return TRUE;
+}
+
+/* The stream time of an internal (MPEG-TS) time, handling MPEG-TS wraparound. Answers
+ * GST_CLOCK_STIME_NONE while no primary fragment has provided a PCR to map from. */
+static GstClockTimeDiff
+gst_hls_demux_internal_to_stream_time (GstHLSDemux * demux,
+    GstClockTime internal_time)
+{
+  if (demux->internal_time == GST_CLOCK_TIME_NONE)
+    return GST_CLOCK_STIME_NONE;
+
+  /* Handle MPEG-TS Wraparound */
+  if (internal_time < demux->internal_time &&
+      demux->internal_time - internal_time > (MPEG_TS_MAX_PTS / 2))
+    internal_time += MPEG_TS_MAX_PTS;
+
+  return (demux->internal_stream_time + internal_time - demux->internal_time);
+}
+
+static GstClockTimeDiff
+webvtt_convert_to_stream_time (GstHLSDemux * demux, GstClockTime localtime,
+    GstClockTime mpegtime, GstClockTime vtt_value)
+{
+  GstClockTimeDiff res;
+
+  if (localtime == GST_CLOCK_TIME_NONE || mpegtime == GST_CLOCK_TIME_NONE) {
+    GST_DEBUG ("No X-TIMESTAMP-MAP, assuming values are MPEG-TS values");
+    res = gst_hls_demux_internal_to_stream_time (demux, vtt_value);
+
+    /* VTT only uses positive values */
+    if (res < 0)
+      res = 0;
+  } else {
+    res =
+        gst_hls_demux_internal_to_stream_time (demux,
+        vtt_value + mpegtime - localtime);
+    if (res == GST_CLOCK_STIME_NONE) {
+      GST_WARNING ("Couldn't convert value, using original value %"
+          GST_TIME_FORMAT, GST_TIME_ARGS (vtt_value));
+      res = vtt_value;
+    } else if (res < 0) {
+      res = 0;
+    }
+  }
+
+  return res;
+}
+
+/* Rewrites the cue timing lines of a whole WebVTT fragment into stream time. */
+static GstBuffer *
+gst_hls_demux_convert_webvtt (GstHLSDemux * demux, GstBuffer * buffer)
+{
+  GstMapInfo info;
+  gchar *original_content;
+  gchar **original_lines;
+  GPtrArray *builder;
+  GstClockTime localtime = GST_CLOCK_TIME_NONE;
+  GstClockTime mpegtime = GST_CLOCK_TIME_NONE;
+  gchar *newfile;
+  guint i, nb;
+
+  if (!gst_buffer_map (buffer, &info, GST_MAP_READ))
+    return buffer;
+  original_content = g_strndup ((gchar *) info.data, info.size);
+  gst_buffer_unmap (buffer, &info);
+  if (!original_content)
+    return buffer;
+
+  builder = g_ptr_array_new_with_free_func (g_free);
+  original_lines = g_strsplit_set (original_content, "\n\r", 0);
+  nb = g_strv_length (original_lines);
+
+  for (i = 0; i < nb; i++) {
+    gchar *line = original_lines[i];
+
+    if (g_str_has_prefix (line, "X-TIMESTAMP-MAP=")) {
+      if (!webvtt_read_x_timestamp_map (line, &localtime, &mpegtime))
+        GST_WARNING_OBJECT (demux, "webvtt timestamp map isn't valid");
+      g_ptr_array_add (builder, g_strdup (line));
+    } else if (strstr (line, " --> ")) {
+      GstClockTime start, stop;
+      const gchar *leftover;
+
+      if (webvtt_process_cue_timing_setting_line (line, &start, &stop,
+              &leftover)) {
+        GstClockTimeDiff start_stream =
+            webvtt_convert_to_stream_time (demux, localtime, mpegtime, start);
+        GstClockTimeDiff stop_stream =
+            webvtt_convert_to_stream_time (demux, localtime, mpegtime, stop);
+
+        if (leftover)
+          g_ptr_array_add (builder,
+              g_strdup_printf ("%" WEBVTT_TIME_FORMAT " --> %"
+                  WEBVTT_TIME_FORMAT " %s", WEBVTT_TIME_ARGS (start_stream),
+                  WEBVTT_TIME_ARGS (stop_stream), leftover));
+        else
+          g_ptr_array_add (builder,
+              g_strdup_printf ("%" WEBVTT_TIME_FORMAT " --> %"
+                  WEBVTT_TIME_FORMAT, WEBVTT_TIME_ARGS (start_stream),
+                  WEBVTT_TIME_ARGS (stop_stream)));
+      } else {
+        GST_WARNING_OBJECT (demux, "Failed to parse time line '%s'", line);
+        g_ptr_array_add (builder, g_strdup (line));
+      }
+    } else {
+      g_ptr_array_add (builder, g_strdup (line));
+    }
+  }
+
+  /* Ensure the file always ends with an empty newline, so downstream parsers detect the
+   * last entry */
+  g_ptr_array_add (builder, g_strdup ("\n"));
+  g_ptr_array_add (builder, NULL);
+  newfile = g_strjoinv ("\n", (gchar **) builder->pdata);
+
+  g_ptr_array_unref (builder);
+  g_strfreev (original_lines);
+  g_free (original_content);
+
+  gst_buffer_unref (buffer);
+  return gst_buffer_new_wrapped (newfile, strlen (newfile));
+}
