+/* The field of a "hls-rendition-tags" event carrying the tags of renditions of a type. */
+static const gchar *
+rendition_tags_field (GstHLSMediaType mtype)
+{
+  switch (mtype) {
+    case GST_HLS_MEDIA_TYPE_AUDIO:
+      return "audio";
+    case GST_HLS_MEDIA_TYPE_VIDEO:
+      return "video";
+    case GST_HLS_MEDIA_TYPE_SUBTITLES:
+      return "text";
+    default:
+      return NULL;
+  }
+}
+
+static GstStreamType
+rendition_stream_type (GstHLSMediaType mtype)
+{
+  switch (mtype) {
+    case GST_HLS_MEDIA_TYPE_AUDIO:
+      return GST_STREAM_TYPE_AUDIO;
+    case GST_HLS_MEDIA_TYPE_VIDEO:
+      return GST_STREAM_TYPE_VIDEO;
+    case GST_HLS_MEDIA_TYPE_SUBTITLES:
+      return GST_STREAM_TYPE_TEXT;
+    default:
+      return GST_STREAM_TYPE_UNKNOWN;
+  }
+}
+
+/* The NAME, LANGUAGE and CHARACTERISTICS an EXT-X-MEDIA rendition declares, as tags. */
+static GstTagList *
+tags_for_media (GstHLSMedia * media)
+{
+  GstTagList *tags;
+
+  if (!media || (!media->name && !media->lang && !media->characteristics
+          && !media->forced))
+    return NULL;
+
+  tags = gst_tag_list_new_empty ();
+  if (media->name)
+    gst_tag_list_add (tags, GST_TAG_MERGE_REPLACE, GST_TAG_TITLE, media->name,
+        NULL);
+  if (media->lang) {
+    if (gst_tag_check_language_code (media->lang))
+      gst_tag_list_add (tags, GST_TAG_MERGE_REPLACE, GST_TAG_LANGUAGE_CODE,
+          media->lang, NULL);
+    else
+      gst_tag_list_add (tags, GST_TAG_MERGE_REPLACE, GST_TAG_LANGUAGE_NAME,
+          media->lang, NULL);
+  }
+  if (media->characteristics
+      || (media->forced && media->mtype == GST_HLS_MEDIA_TYPE_SUBTITLES)) {
+    /* FORCED=YES is the characteristic AVFoundation names
+     * AVMediaCharacteristicContainsOnlyForcedSubtitles */
+    gchar *characteristics =
+        media->forced && media->mtype == GST_HLS_MEDIA_TYPE_SUBTITLES ?
+        g_strjoin (",", media->characteristics ? media->characteristics : "",
+        "public.subtitles.forced-only", NULL) :
+        g_strdup (media->characteristics);
+
+    gst_tag_list_add (tags, GST_TAG_MERGE_REPLACE,
+        GST_HLS_DEMUX_TAG_CHARACTERISTICS,
+        characteristics[0] == ',' ? characteristics + 1 : characteristics, NULL);
+    g_free (characteristics);
+  }
+
+  return tags;
+}
+
+/* The tags of a rendition with its own stream, so a player can label the track and match it
+ * against language preferences. They are kept on the stream and go out with every tag event it
+ * sends, including the ID3 tags of a packed audio fragment, and in the GstStream of its
+ * stream-start event. A demuxer splitting the rendition's fragments applies them over the
+ * container's own tags from the stream's "hls-rendition-tags" event, as for a rendition carried
+ * inside the variant's stream. */
+static void
+set_tags_for_media (GstAdaptiveDemuxStream * stream, GstHLSMedia * media)
+{
+  GstTagList *tags = tags_for_media (media);
+  const gchar *field;
+
+  if (!tags)
+    return;
+
+  field = rendition_tags_field (media->mtype);
+  if (field)
+    gst_adaptive_demux_stream_queue_event (stream,
+        gst_event_new_custom (GST_EVENT_CUSTOM_DOWNSTREAM_STICKY,
+            gst_structure_new ("hls-rendition-tags", field, GST_TYPE_TAG_LIST,
+                tags, NULL)));
+
+  stream->stream_type = rendition_stream_type (media->mtype);
+  gst_tag_list_replace (&stream->stream_tags, tags);
+  gst_adaptive_demux_stream_set_tags (stream, tags);
+}
+
+/* A rendition without a URI is carried inside the variant's own stream. Its tags travel with
+ * that stream in a sticky "hls-rendition-tags" event holding one tag list per stream type, so
+ * the demuxer that splits the variant's stream applies each list to its streams of that type
+ * only, the way the successor element attaches such a rendition to the variant's track of the
+ * matching type. */
+static void
+queue_tags_for_variant_media (GstAdaptiveDemuxStream * stream,
+    GstHLSVariantStream * variant)
+{
+  static const GstHLSMediaType types[] = {
+    GST_HLS_MEDIA_TYPE_AUDIO, GST_HLS_MEDIA_TYPE_VIDEO,
+    GST_HLS_MEDIA_TYPE_SUBTITLES,
+  };
+  GstStructure *s = NULL;
+  guint i;
+
+  for (i = 0; i < G_N_ELEMENTS (types); i++) {
+    GList *l;
+
+    for (l = variant->media[types[i]]; l; l = l->next) {
+      GstHLSMedia *media = l->data;
+      GstTagList *tags;
+
+      if (media->uri != NULL)
+        continue;
+
+      tags = tags_for_media (media);
+      if (tags) {
+        const gchar *field = rendition_tags_field (types[i]);
+
+        if (!s)
+          s = gst_structure_new_empty ("hls-rendition-tags");
+        gst_structure_set (s, field, GST_TYPE_TAG_LIST, tags, NULL);
+        gst_tag_list_unref (tags);
+        if (media->is_default) {
+          gchar *default_field = g_strconcat (field, "-default", NULL);
+          gst_structure_set (s, default_field, G_TYPE_BOOLEAN, TRUE, NULL);
+          g_free (default_field);
+        }
+      }
+      break;
+    }
+  }
+
+  if (s)
+    gst_adaptive_demux_stream_queue_event (stream,
+        gst_event_new_custom (GST_EVENT_CUSTOM_DOWNSTREAM_STICKY, s));
+}
