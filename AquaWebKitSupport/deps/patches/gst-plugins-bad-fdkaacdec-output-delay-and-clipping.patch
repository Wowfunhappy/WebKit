+/* Takes the decoder's delayed samples for every pending frame, and finishes
+ * them all. */
+static GstFlowReturn
+gst_fdkaacdec_drain (GstFdkAacDec * self)
+{
+  guint bpf = GST_AUDIO_INFO_BPF (&self->info);
+  guint64 owed = 0;
+  GstFlowReturn ret;
+  GList *l;
+
+  for (l = self->pending_frames.head; l; l = l->next)
+    owed += MAX (((GstFdkAacDecFrame *) l->data)->samples, 0);
+
+  while (self->dec && bpf && owed > self->pending_samples->len / bpf) {
+    AAC_DECODER_ERROR err;
+    CStreamInfo *stream_info;
+
+    err = aacDecoder_DecodeFrame (self->dec, self->decode_buffer,
+        self->decode_buffer_size, AACDEC_FLUSH);
+    if (!IS_OUTPUT_VALID (err))
+      break;
+
+    stream_info = aacDecoder_GetStreamInfo (self->dec);
+    if (!stream_info || stream_info->frameSize <= 0 ||
+        stream_info->numChannels != GST_AUDIO_INFO_CHANNELS (&self->info))
+      break;
+
+    gst_fdkaacdec_queue_output (self, stream_info->frameSize);
   }
 
+  ret = gst_fdkaacdec_finish_frames (self, TRUE);
