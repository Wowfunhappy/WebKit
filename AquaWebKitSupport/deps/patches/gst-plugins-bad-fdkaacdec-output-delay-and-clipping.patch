+/* Appends the decoder's latest output to the pending samples, past whatever
+ * is left of its output delay. */
+static void
+gst_fdkaacdec_queue_output (GstFdkAacDec * self, guint samples)
+{
+  guint bpf = GST_AUDIO_INFO_BPF (&self->info);
+  guint skip = MIN ((guint) self->delay_to_skip, samples);
+
+  self->delay_to_skip -= skip;
+  if (self->need_reorder) {
+    gst_audio_reorder_channels (self->decode_buffer + skip *
+        GST_AUDIO_INFO_CHANNELS (&self->info), (samples - skip) * bpf,
+        GST_AUDIO_INFO_FORMAT (&self->info),
+        GST_AUDIO_INFO_CHANNELS (&self->info), self->positions,
+        self->info.position);
+  }
+  g_byte_array_append (self->pending_samples,
+      (const guint8 *) self->decode_buffer + skip * bpf, (samples - skip) * bpf);
+}
+
+/* Hands out the oldest frames' samples as they come out of the decoder, so
+ * no more than its output delay is held back, and finishes each frame once its
+ * last samples are out. When draining, a frame the decoder holds no more samples for
+ * finishes with what is left. */
+static GstFlowReturn
+gst_fdkaacdec_finish_frames (GstFdkAacDec * self, gboolean draining)
+{
+  GstAudioDecoder *dec = GST_AUDIO_DECODER (self);
+  guint bpf = GST_AUDIO_INFO_BPF (&self->info);
+  GstFdkAacDecFrame *frame;
+  GstFlowReturn ret = GST_FLOW_OK;
+
+  while ((frame = g_queue_peek_head (&self->pending_frames))) {
+    guint available = bpf ? self->pending_samples->len / bpf : 0;
+    guint remaining, take;
+    guint64 from, to;
+    gboolean last;
+    GstBuffer *outbuf = NULL;
+
+    if (frame->samples < 0)
+      break;
+
+    remaining = frame->samples - frame->emitted;
+    take = MIN (remaining, available);
+    last = take == remaining || draining;
+    if (!take && !last)
+      break;
+
+    /* The part of the samples taken that lies between the frame's clipped
+     * head and tail. */
+    from = MAX (frame->emitted, frame->clip_start);
+    to = MIN (frame->emitted + take,
+        frame->samples - MIN (frame->clip_end, (guint64) frame->samples));
+    if (to > from) {
+      outbuf = gst_audio_decoder_allocate_output_buffer (dec,
+          (to - from) * bpf);
+      gst_buffer_fill (outbuf, 0, self->pending_samples->data +
+          (from - frame->emitted) * bpf, (to - from) * bpf);
+    }
+    g_byte_array_remove_range (self->pending_samples, 0, take * bpf);
+    frame->emitted += take;
+
+    if (outbuf) {
+      ret = gst_audio_decoder_finish_subframe (dec, outbuf);
+      if (ret != GST_FLOW_OK)
+        break;
+    }
+    if (!last)
+      break;
+
+    g_free (g_queue_pop_head (&self->pending_frames));
+    ret = gst_audio_decoder_finish_subframe (dec, NULL);
+    if (ret != GST_FLOW_OK)
+      break;
+  }
+
+  return ret;
+}
