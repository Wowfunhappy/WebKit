+/* GstAudioDecoder drops its queued input frames on FLUSH_STOP, but calls
+ * flush() only once it has output samples. */
+static gboolean
+gst_fdkaacdec_sink_event (GstAudioDecoder * dec, GstEvent * event)
+{
+  if (GST_EVENT_TYPE (event) == GST_EVENT_FLUSH_STOP) {
+    GST_AUDIO_DECODER_STREAM_LOCK (dec);
+    gst_fdkaacdec_flush (dec, TRUE);
+    GST_AUDIO_DECODER_STREAM_UNLOCK (dec);
+  }
+
+  return GST_AUDIO_DECODER_CLASS (gst_fdkaacdec_parent_class)->sink_event (dec,
+      event);
 }
 
