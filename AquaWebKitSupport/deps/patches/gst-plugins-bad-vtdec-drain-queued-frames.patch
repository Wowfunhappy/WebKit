# gst_vtdec_drain_decoder waits until the output loop has taken every queued frame, or has
# paused itself after a downstream error, before it pauses the output task. Reordering
# remains active until every native callback has completed; a flush drain
# resumes a loop that stopped on an error only after that loop has finished pausing.
# See patches/README.md.
--- a/sys/applemedia/vtdec.h	2026-09-12 18:36:34.000000000 -0400
+++ b/sys/applemedia/vtdec.h	2026-09-12 18:36:34.000000000 -0400
@@ -67,6 +67,9 @@
   gboolean is_flushing;
   gboolean is_draining;
   gboolean pause_task;
+  /* Set once the output loop has paused itself after a downstream error, and
+   * cleared before the loop is resumed; protected by queue_mutex */
+  gboolean output_stopped;
   
   /* protected by the STREAM_LOCK */
   GstFlowReturn downstream_ret;
--- a/sys/applemedia/vtdec.c	2026-09-12 18:36:34.000000000 -0400
+++ b/sys/applemedia/vtdec.c	2026-09-12 18:36:34.000000000 -0400
@@ -328,6 +328,7 @@
 
   vtdec->is_flushing = FALSE;
   vtdec->is_draining = FALSE;
+  vtdec->output_stopped = FALSE;
   vtdec->downstream_ret = GST_FLOW_OK;
   g_atomic_int_set (&vtdec->require_reset, FALSE);
   vtdec->reorder_queue = gst_vec_deque_new (0);
@@ -434,7 +435,7 @@
     gboolean is_flushing = vtdec->is_flushing;
 
     frame = gst_vec_deque_pop_head (vtdec->reorder_queue);
-    g_cond_signal (&vtdec->queue_cond);
+    g_cond_broadcast (&vtdec->queue_cond);
     g_mutex_unlock (&vtdec->queue_mutex);
 
     /* we need to check this in case dpb_size=0 (jpeg for
@@ -494,6 +495,11 @@
     GST_DEBUG_OBJECT (vtdec, "pausing output task because of downstream: %s",
         gst_flow_get_name (ret));
     gst_pad_pause_task (GST_VIDEO_DECODER_SRC_PAD (decoder));
+
+    g_mutex_lock (&vtdec->queue_mutex);
+    vtdec->output_stopped = TRUE;
+    g_cond_broadcast (&vtdec->queue_cond);
+    g_mutex_unlock (&vtdec->queue_mutex);
   }
 }
 
@@ -511,7 +517,7 @@
 {
   g_mutex_lock (&vtdec->queue_mutex);
   vtdec->pause_task = TRUE;
-  g_cond_signal (&vtdec->queue_cond);
+  g_cond_broadcast (&vtdec->queue_cond);
   g_mutex_unlock (&vtdec->queue_mutex);
 
   gst_pad_pause_task (GST_VIDEO_DECODER_SRC_PAD (vtdec));
@@ -1811,10 +1817,13 @@
   }
 
   g_mutex_lock (&vtdec->queue_mutex);
+  /* downstream_ret is written under the stream lock held here, so a loop that
+   * reported an error has left it and pauses itself before output_stopped is
+   * set. Waiting for that keeps its pause from landing after the resume below. */
+  while (vtdec->downstream_ret != GST_FLOW_OK && !vtdec->output_stopped)
+    g_cond_wait (&vtdec->queue_cond, &vtdec->queue_mutex);
+  vtdec->output_stopped = FALSE;
   if (flush) {
     GST_DEBUG_OBJECT (vtdec, "setting flushing flag");
     vtdec->is_flushing = TRUE;
-  } else {
-    GST_DEBUG_OBJECT (vtdec, "setting draining flag");
-    vtdec->is_draining = TRUE;
   }
@@ -1835,6 +1844,20 @@
         (int) vt_status);
   }
 
+  /* A paused task runs no further iteration, so the drain waits until the loop
+   * has taken every queued frame or has stopped. */
+  g_mutex_lock (&vtdec->queue_mutex);
+  /* Native callbacks have completed, so the sorted queue is ready to drain. */
+  if (!flush) {
+    GST_DEBUG_OBJECT (vtdec, "setting draining flag");
+    vtdec->is_draining = TRUE;
+    g_cond_broadcast (&vtdec->queue_cond);
+  }
+  while (!gst_vec_deque_is_empty (vtdec->reorder_queue) && !vtdec->pause_task
+      && !vtdec->output_stopped)
+    g_cond_wait (&vtdec->queue_cond, &vtdec->queue_mutex);
+  g_mutex_unlock (&vtdec->queue_mutex);
+
   /* This will only pause after all frames are out because is_flushing/is_draining=TRUE */
   gst_vtdec_pause_output_loop (vtdec);
   GST_VIDEO_DECODER_STREAM_LOCK (vtdec);
