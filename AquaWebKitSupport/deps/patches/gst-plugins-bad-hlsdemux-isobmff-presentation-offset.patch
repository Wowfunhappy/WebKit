+   * presentation offset */
+  gboolean is_isobmff;
+  GstMoovBox *moov;
+  GstClockTime first_isobmff_time;
+  GstBuffer *pending_isobmff_buffer;
+  GstClockTime presentation_offset;     /* GST_CLOCK_TIME_NONE until its segment carries it */
