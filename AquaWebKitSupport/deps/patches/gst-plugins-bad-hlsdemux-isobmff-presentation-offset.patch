+static gboolean
+caps_are_isobmff (const GstCaps * caps)
+{
+  const GstStructure *s = gst_caps_get_structure (caps, 0);
+
+  return gst_structure_has_name (s, "video/quicktime")
+      || gst_structure_has_name (s, "audio/x-m4a")
+      || gst_structure_has_name (s, "application/x-3gp")
+      || gst_structure_has_name (s, "video/mj2");
+}
+
+/* Records the movie box of an ISOBMFF stream and, from the first movie fragment after it, the
+ * earliest decode time of its tracks. This is hlsdemux2's gst_hlsdemux_handle_content_isobmff
+ * (ext/adaptivedemux2/hls/gsthlsdemux-util.c), run over the data held since the stream began. */
+static void
+gst_hls_demux_stream_find_isobmff_time (GstHLSDemuxStream * hls_stream,
+    GstBuffer * buffer)
+{
+  GstMapInfo info;
+  GstByteReader br, sub;
+  guint32 box_type;
+  guint header_size;
+  guint64 box_size;
+  GstClockTime smallest_ts = GST_CLOCK_TIME_NONE;
+
+  if (!gst_buffer_map (buffer, &info, GST_MAP_READ))
+    return;
+
+  gst_byte_reader_init (&br, info.data, info.size);
+
+  while (gst_byte_reader_get_remaining (&br) &&
+      gst_isoff_parse_box_header (&br, &box_type, NULL, &header_size,
+          &box_size)) {
+    /* A box still arriving is read again with the rest of its data */
+    if (box_size < header_size
+        || box_size - header_size > gst_byte_reader_get_remaining (&br))
+      break;
+
+    switch (box_type) {
+      case GST_ISOFF_FOURCC_MOOV:
+      {
+        GstMoovBox *moov;
+
+        gst_byte_reader_get_sub_reader (&br, &sub, box_size - header_size);
+        moov = gst_isoff_moov_box_parse (&sub);
+        if (moov) {
+          if (hls_stream->moov)
+            gst_isoff_moov_box_free (hls_stream->moov);
+          hls_stream->moov = moov;
+        }
+        break;
+      }
+      case GST_ISOFF_FOURCC_MOOF:
+      {
+        GstMoofBox *moof;
+        guint i, j;
+
+        if (hls_stream->moov == NULL) {
+          GST_WARNING ("Received moof without moov in iso-ff stream");
+          goto out;
+        }
+
+        gst_byte_reader_get_sub_reader (&br, &sub, box_size - header_size);
+        moof = gst_isoff_moof_box_parse (&sub);
+        if (!moof) {
+          GST_WARNING ("Failed to parse moof");
+          goto out;
+        }
+
+        for (i = 0; i < hls_stream->moov->trak->len; i++) {
+          GstTrakBox *trak =
+              &g_array_index (hls_stream->moov->trak, GstTrakBox, i);
+          for (j = 0; j < moof->traf->len; j++) {
+            GstTrafBox *traf = &g_array_index (moof->traf, GstTrafBox, j);
+            if (traf->tfhd.track_id == trak->tkhd.track_id) {
+              GstClockTime ts = 0;
+              guint64 decode_time = traf->tfdt.decode_time;
+
+              if (decode_time != GST_CLOCK_TIME_NONE)
+                ts = gst_util_uint64_scale (decode_time, GST_SECOND,
+                    trak->mdia.mdhd.timescale);
+
+              if (smallest_ts == GST_CLOCK_TIME_NONE || ts < smallest_ts)
+                smallest_ts = ts;
+            }
+          }
+        }
+        gst_isoff_moof_box_free (moof);
+        goto out;
+      }
+      case GST_ISOFF_FOURCC_MDAT:
+        goto out;
+      default:
+        gst_byte_reader_skip (&br, box_size - header_size);
+        break;
+    }
+  }
+
+out:
+  gst_buffer_unmap (buffer, &info);
+
+  if (GST_CLOCK_TIME_IS_VALID (smallest_ts)) {
+    GST_DEBUG ("First ISOBMFF decode time %" GST_TIME_FORMAT,
+        GST_TIME_ARGS (smallest_ts));
+    hls_stream->first_isobmff_time = smallest_ts;
+  }
+}
+
+/* The amount by which an ISOBMFF stream's own timestamps run ahead of the stream time of its
+ * first fragment, or GST_CLOCK_TIME_NONE before its first movie fragment. */
+static GstClockTime
+gst_hls_demux_stream_own_isobmff_offset (GstHLSDemuxStream * hls_stream)
+{
+  GstAdaptiveDemuxStream *stream = (GstAdaptiveDemuxStream *) hls_stream;
+  GstClockTime fragment_time = stream->fragment.timestamp;
+
+  if (!GST_CLOCK_TIME_IS_VALID (hls_stream->first_isobmff_time))
+    return GST_CLOCK_TIME_NONE;
+  if (!GST_CLOCK_TIME_IS_VALID (fragment_time)
+      || hls_stream->first_isobmff_time < fragment_time)
+    return 0;
+  return hls_stream->first_isobmff_time - fragment_time;
+}
+
+/* The presentation offset of an ISOBMFF stream, or GST_CLOCK_TIME_NONE while it is not known.
+ * As in hlsdemux2 (gst_hls_demux_stream_get_presentation_offset), a rendition takes the primary
+ * stream's offset when that stream is ISOBMFF too, which keeps it in sync with the primary
+ * stream, and its own otherwise. The primary stream's first movie fragment also maps internal
+ * time to stream time for the subtitle renditions, as its first PCR does for MPEG-TS. A stream
+ * whose media fragment ends without a movie fragment has no offset, nor does a rendition still
+ * waiting for the primary stream when its own playlist ends. */
+static GstClockTime
+gst_hls_demux_stream_isobmff_offset (GstHLSDemux * hlsdemux,
+    GstHLSDemuxStream * hls_stream, gboolean at_eos)
+{
+  GstAdaptiveDemuxStream *stream = (GstAdaptiveDemuxStream *) hls_stream;
+  gboolean fragment_ended = at_eos && !stream->downloading_header;
+  GstClockTime offset = gst_hls_demux_stream_own_isobmff_offset (hls_stream);
+
+  if (hls_stream->is_primary_playlist) {
+    if (!GST_CLOCK_TIME_IS_VALID (offset)) {
+      if (!fragment_ended)
+        return GST_CLOCK_TIME_NONE;
+      offset = 0;
+    } else {
+      hlsdemux->internal_time = hls_stream->first_isobmff_time;
+      hlsdemux->internal_stream_time = stream->fragment.timestamp;
+    }
+    hlsdemux->presentation_offset = offset;
+    GST_DEBUG_OBJECT (stream->pad, "Presentation offset %" GST_TIME_FORMAT,
+        GST_TIME_ARGS (offset));
+    return offset;
+  }
+
+  if (hlsdemux->primary_type_known && !hlsdemux->primary_is_isobmff) {
+    if (GST_CLOCK_TIME_IS_VALID (offset) || !fragment_ended)
+      return offset;
+    return 0;
+  }
+
+  if (GST_CLOCK_TIME_IS_VALID (hlsdemux->presentation_offset))
+    return hlsdemux->presentation_offset;
+
+  if (fragment_ended && !gst_hls_demux_is_live (GST_ADAPTIVE_DEMUX_CAST (hlsdemux))
+      && !gst_hls_demux_stream_has_next_fragment (stream))
+    return GST_CLOCK_TIME_IS_VALID (offset) ? offset : 0;
+
+  return GST_CLOCK_TIME_NONE;
+}
+
+/* The base class built this stream's segment while its presentation offset was still 0 to it:
+ * shift it, and the segment event still to go out with the stream's first buffer, by the offset.
+ * The base class builds every later segment with it (gst_hls_demux_get_presentation_offset). */
+static void
+gst_hls_demux_stream_apply_presentation_offset (GstAdaptiveDemuxStream * stream,
+    GstClockTime offset)
+{
+  GstHLSDemuxStream *hls_stream = GST_HLS_DEMUX_STREAM_CAST (stream);
+  GstEvent *segment_event;
+
+  hls_stream->presentation_offset = offset;
+  if (!offset)
+    return;
+
+  stream->segment.start += offset;
+  if (GST_CLOCK_TIME_IS_VALID (stream->segment.stop))
+    stream->segment.stop += offset;
+  stream->segment.position += offset;
+
+  segment_event = gst_event_new_segment (&stream->segment);
+  if (stream->pending_segment)
+    gst_event_set_seqnum (segment_event,
+        gst_event_get_seqnum (stream->pending_segment));
+  gst_event_replace (&stream->pending_segment, segment_event);
+  gst_event_unref (segment_event);
+  GST_DEBUG_OBJECT (stream->pad, "Segment now %" GST_SEGMENT_FORMAT,
+      &stream->segment);
+}
+
+static GstClockTime
+gst_hls_demux_get_presentation_offset (GstAdaptiveDemux * demux,
+    GstAdaptiveDemuxStream * stream)
+{
+  GstHLSDemuxStream *hls_stream = GST_HLS_DEMUX_STREAM_CAST (stream);
+
+  if (!GST_CLOCK_TIME_IS_VALID (hls_stream->presentation_offset))
+    return 0;
+  return hls_stream->presentation_offset;
+}
