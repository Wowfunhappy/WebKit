   cm_sample_buffer =
       cm_sample_buffer_from_gst_buffer (vtdec, frame->input_buffer);
 
+  g_mutex_lock (&vtdec->queue_mutex);
+  frame->flags &= ~VTDEC_FRAME_FLAG_COMPLETE;
+  g_queue_push_tail (&vtdec->submitted_frames, frame);
+  gst_video_codec_frame_ref (frame);
+  g_mutex_unlock (&vtdec->queue_mutex);
+
   status = VTDecompressionSessionDecodeFrame (vtdec->session, cm_sample_buffer,
       input_flags, frame, NULL);
 
   GST_LOG_OBJECT (vtdec, "VTDecompressionSessionDecodeFrame returned: %d",
       status);
+
+  g_mutex_lock (&vtdec->queue_mutex);
+  callback_completed = (frame->flags & VTDEC_FRAME_FLAG_COMPLETE) != 0;
+  if (status != noErr && !callback_completed) {
+    g_queue_remove (&vtdec->submitted_frames, frame);
+    gst_vtdec_promote_completed_frames (vtdec);
+  }
+  g_mutex_unlock (&vtdec->queue_mutex);
+  gst_video_codec_frame_unref (frame);
+
+  /* A synchronous failure may also complete through the output callback. The
+   * callback owns that frame and its output-loop error reporting. */
+  if (status != noErr && callback_completed) {
+    GST_VIDEO_DECODER_ERROR (vtdec, 1, STREAM, DECODE,
+        ("Failed to decode frame"),
+        ("VTDecompressionSessionDecodeFrame returned %d", (int) status), ret);
+    goto out;
+  }
 
   /* kVTInvalidSessionErr is usually returned on iOS if the application goes
    * into background mode, if so, we can reset the session and request an
@@ -1228,7 +1257,7 @@
