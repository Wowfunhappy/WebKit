+}
+
+/* queue_mutex protects submission order and completion publication. Only a
+ * completed prefix enters the PTS queue, including skipped and errored frames. */
+static void
+gst_vtdec_promote_completed_frames (GstVtdec * vtdec)
+{
+  GstVideoCodecFrame *frame;
+
+  while ((frame = g_queue_peek_head (&vtdec->submitted_frames)) &&
+      (frame->flags & VTDEC_FRAME_FLAG_COMPLETE)) {
+    g_queue_pop_head (&vtdec->submitted_frames);
+    gst_vec_deque_push_sorted (vtdec->reorder_queue,
+        frame, sort_frames_by_pts, NULL);
+  }
+  g_cond_signal (&vtdec->queue_cond);
 }
 
