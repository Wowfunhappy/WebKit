+/* RFC 9113 section 8.2.3: the cookie field travels as one header per pair,
+ * which is how it compresses and how a browser sends it. */
+static int h2_is_cookie(const struct dynhds_entry *e)
+{
+  return e->namelen == 6 && !strncmp(e->name, "cookie", 6);
+}
+
+static CURLcode h2_crumble_cookies(struct dynhds *hds)
+{
+  struct dynhds crumbs;
+  CURLcode result = CURLE_OK;
+  size_t i, count = Curl_dynhds_count(hds);
+
+  for(i = 0; i < count; i++) {
+    struct dynhds_entry *e = Curl_dynhds_getn(hds, i);
+    if(h2_is_cookie(e) && memchr(e->value, ';', e->valuelen))
+      break;
+  }
+  if(i == count)
+    return CURLE_OK;
+
+  Curl_dynhds_init(&crumbs, 0, DYN_HTTP_REQUEST);
+  Curl_dynhds_set_opts(&crumbs, DYNHDS_OPT_LOWERCASE);
+  for(i = 0; i < count && !result; i++) {
+    struct dynhds_entry *e = Curl_dynhds_getn(hds, i);
+    if(!h2_is_cookie(e)) {
+      result = Curl_dynhds_add(&crumbs, e->name, e->namelen,
+                               e->value, e->valuelen);
+    }
+    else {
+      const char *p = e->value;
+      const char *end = e->value + e->valuelen;
+      while(p < end && !result) {
+        const char *sep = memchr(p, ';', (size_t)(end - p));
+        const char *stop = sep ? sep : end;
+        size_t len;
+        while(p < stop && (*p == ' ' || *p == '\t'))
+          p++;
+        len = (size_t)(stop - p);
+        while(len && (p[len - 1] == ' ' || p[len - 1] == '\t'))
+          len--;
+        if(len)
+          result = Curl_dynhds_add(&crumbs, "cookie", 6, p, len);
+        p = sep ? sep + 1 : end;
+      }
+    }
+  }
+  if(result)
+    Curl_dynhds_free(&crumbs);
+  else {
+    Curl_dynhds_free(hds);
+    *hds = crumbs;
+  }
+  return result;
+}
