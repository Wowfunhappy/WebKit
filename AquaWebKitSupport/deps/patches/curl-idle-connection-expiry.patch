+struct cpool_idle_expiry_ctx {
+  struct curltime now;
+  timediff_t max_idle_ms;
+  timediff_t next_ms;
+};
+
+static int cpool_find_next_idle_expiry(struct cpool *cpool,
+                                       struct Curl_easy *admin,
+                                       struct connectdata *conn, void *param)
+{
+  struct cpool_idle_expiry_ctx *expiry = param;
+  timediff_t age_ms;
+  timediff_t remaining_ms;
+
+  (void)cpool;
+  (void)admin;
+  if(CONN_INUSE(conn))
+    return 0;
+  age_ms = curlx_ptimediff_ms(&expiry->now, &conn->lastused);
+  remaining_ms = expiry->max_idle_ms - age_ms + 1;
+  if(remaining_ms < 0)
+    remaining_ms = 0;
+  if(expiry->next_ms < 0 || remaining_ms < expiry->next_ms)
+    expiry->next_ms = remaining_ms;
+  return 0;
+}
+
+static void cpool_schedule_idle_expiry_locked(struct cpool *cpool,
+                                              struct Curl_easy *admin)
+{
+  struct cpool_idle_expiry_ctx expiry;
+
+  if(!admin->set.conn_max_idle_ms) {
+    Curl_expire_clear(admin, EXPIRE_CPOOL);
+    return;
+  }
+  expiry.now = *Curl_pgrs_now(admin);
+  expiry.max_idle_ms = admin->set.conn_max_idle_ms;
+  expiry.next_ms = -1;
+  cpool_foreach(admin, cpool, &expiry, cpool_find_next_idle_expiry);
+  if(expiry.next_ms >= 0)
+    Curl_expire(admin, expiry.next_ms, EXPIRE_CPOOL);
+  else
+    Curl_expire_clear(admin, EXPIRE_CPOOL);
+}
+
