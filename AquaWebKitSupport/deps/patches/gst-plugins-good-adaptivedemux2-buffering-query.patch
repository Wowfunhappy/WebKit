 static gboolean
+gst_adaptive_demux_handle_query_buffering (GstAdaptiveDemux * demux,
+    GstQuery * query)
+{
+  gint percent;
+  gboolean busy;
+
+  g_mutex_lock (&demux->priv->query_lock);
+  percent = demux->priv->query_percent;
+  busy = demux->priv->query_busy;
+  g_mutex_unlock (&demux->priv->query_lock);
+
+  gst_query_set_buffering_percent (query, percent < 0 || busy,
+      MAX (percent, 0));
+  gst_query_set_buffering_stats (query, GST_BUFFERING_STREAM, -1, -1, -1);
+  return TRUE;
+}
