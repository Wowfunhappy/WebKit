# A frame VideoToolbox fails to encode for a reason a session restart does not cover makes
# the encode call, the next frame and the next drain answer GST_FLOW_ERROR. See patches/README.md.
--- a/sys/applemedia/vtenc.h	2026-09-12 18:36:34.000000000 -0400
+++ b/sys/applemedia/vtenc.h	2026-09-12 18:36:34.000000000 -0400
@@ -138,6 +138,11 @@
    * so we instead reconfigure on next encode call. */
   gboolean require_reconfigure;
 
+  /* Set when VideoToolbox fails to encode a frame for a reason a session
+   * restart does not cover, so the next encode or drain answers
+   * GST_FLOW_ERROR. */
+  gboolean encode_failed;
+
   /* DTS offset: frame2 PTS - frame1 PTS
    * Explanation here: https://gitlab.freedesktop.org/gstreamer/gstreamer/-/merge_requests/6791#note_2396581 */
   GstClockTime dts_offset;
--- a/sys/applemedia/vtenc.c	2026-09-12 18:36:34.000000000 -0400
+++ b/sys/applemedia/vtenc.c	2026-09-12 18:36:34.000000000 -0400
@@ -852,6 +852,12 @@
     self->is_draining = FALSE;
   }
 
+  if (!flush && self->downstream_ret == GST_FLOW_OK
+      && g_atomic_int_get (&self->encode_failed)) {
+    GST_WARNING_OBJECT (self, "a frame failed to encode before the drain");
+    return GST_FLOW_ERROR;
+  }
+
   if (self->downstream_ret == GST_FLOW_OK)
     GST_DEBUG_OBJECT (self, "buffer queue cleaned");
   else
@@ -877,6 +883,7 @@
   self->downstream_ret = GST_FLOW_OK;
   g_atomic_int_set (&self->require_restart, FALSE);
   g_atomic_int_set (&self->require_reconfigure, FALSE);
+  g_atomic_int_set (&self->encode_failed, FALSE);
 
   self->output_queue = gst_vec_deque_new (VTENC_OUTPUT_QUEUE_SIZE);
   /* Set clear_func to unref all remaining frames in gst_vec_deque_free() */
@@ -1429,6 +1436,7 @@
   gst_vtenc_drain_encoder (self, TRUE);
 
   self->downstream_ret = GST_FLOW_OK;
+  g_atomic_int_set (&self->encode_failed, FALSE);
 
   return TRUE;
 }
@@ -2180,6 +2188,12 @@
     }
   }
 
+  if (g_atomic_int_get (&self->encode_failed)) {
+    GST_WARNING_OBJECT (self, "an earlier frame failed to encode");
+    ret = GST_FLOW_ERROR;
+    goto drop;
+  }
+
   /* Flushes all remaining frames out of the encoder
    * and recreates the encoding session. */
   if (g_atomic_int_get (&self->require_restart))
@@ -2387,6 +2401,8 @@
     GST_ELEMENT_ERROR (self, LIBRARY, ENCODE, (NULL),
         ("Failed to encode frame %d: %d", frame->system_frame_number,
             (int) vt_status));
+    g_atomic_int_set (&self->encode_failed, TRUE);
+    ret = GST_FLOW_ERROR;
   }
 
   gst_video_codec_frame_unref (frame);
@@ -2431,13 +2447,16 @@
           ("Failed to encode frame (%d), restarting session on next frame encode",
               (int) status));
       g_atomic_int_set (&self->require_restart, TRUE);
-    } else if (frame) {
-      GST_ELEMENT_ERROR (self, LIBRARY, ENCODE, (NULL),
-          ("Failed to encode frame %d: %d", frame->system_frame_number,
-              (int) status));
     } else {
-      GST_ELEMENT_ERROR (self, LIBRARY, ENCODE, (NULL),
-          ("Failed to encode (frame unknown): %d", (int) status));
+      g_atomic_int_set (&self->encode_failed, TRUE);
+      if (frame) {
+        GST_ELEMENT_ERROR (self, LIBRARY, ENCODE, (NULL),
+            ("Failed to encode frame %d: %d", frame->system_frame_number,
+                (int) status));
+      } else {
+        GST_ELEMENT_ERROR (self, LIBRARY, ENCODE, (NULL),
+            ("Failed to encode (frame unknown): %d", (int) status));
+      }
     }
 
     goto drop;
