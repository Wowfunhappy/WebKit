+static void gst_qtdemux_stream_flush_samples_data (QtDemuxStream * stream);
 static GstFlowReturn qtdemux_prepare_streams (GstQTDemux * qtdemux);
 static void qtdemux_do_allocation (QtDemuxStream * stream,
     GstQTDemux * qtdemux);
