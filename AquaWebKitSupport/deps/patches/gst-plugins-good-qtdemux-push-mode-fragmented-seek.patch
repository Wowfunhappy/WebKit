@@ -4845,6 +4894,25 @@
 
   qtdemux->first_moof_already_parsed = TRUE;
 
+  /* push mode keeps no sample of an earlier fragment, so a seek back starts
+   * over from its [moof] */
+  if (!qtdemux->pullbased && !qtdemux->upstream_format_is_time
+      && qtdemux->variant == VARIANT_NONE
+      && GST_CLOCK_TIME_IS_VALID (fragment_dts)) {
+    GArray *index = qtdemux->push_fragment_index;
+
+    if (index->len == 0
+        || g_array_index (index, QtDemuxRandomAccessEntry,
+            index->len - 1).moof_offset < moof_offset) {
+      QtDemuxRandomAccessEntry entry = { fragment_dts, moof_offset };
+
+      GST_LOG_OBJECT (qtdemux, "fragment %u starts at %" GST_TIME_FORMAT
+          ", [moof] offset %" G_GUINT64_FORMAT, index->len,
+          GST_TIME_ARGS (fragment_dts), moof_offset);
+      g_array_append_val (index, entry);
+    }
+  }
+
   g_node_destroy (moof_node);
   return TRUE;
 
