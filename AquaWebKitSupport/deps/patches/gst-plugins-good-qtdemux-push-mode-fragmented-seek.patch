           goto exit;
         }
@@ -2401,6 +2431,19 @@
             "set values to restart reading from a new atom");
         demux->neededbytes = 16;
         demux->todrop = 0;
+      } else if (demux->push_fragment_seek && demux->seek_offset == offset) {
+        gint i;
+
+        GST_DEBUG_OBJECT (demux, "Restarting at the [moof] at offset %"
+            G_GINT64_FORMAT, offset);
+        for (i = 0; i < QTDEMUX_N_STREAMS (demux); i++)
