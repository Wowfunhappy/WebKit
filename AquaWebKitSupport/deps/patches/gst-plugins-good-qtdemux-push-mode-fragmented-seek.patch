# Push-mode fragmented files seek to the start of a fragment the demuxer
# has parsed. See patches/README.md.
# Applied after gst-plugins-good-qtdemux-push-mode-decode-time-interleave.patch.

--- a/gst/isomp4/qtdemux.h
+++ b/gst/isomp4/qtdemux.h
@@ -287,6 +287,12 @@
   gint64 push_seek_start;
   gint64 push_seek_stop;
 
+  /* PUSH-BASED fragmented, BYTE upstream: the start time and [moof] offset of
+   * every fragment parsed, in offset order, for seeking back to one of them */
+  GArray *push_fragment_index;
+  /* PUSH-BASED fragmented: the BYTE seek sent upstream lands on a [moof] */
+  gboolean push_fragment_seek;
+
   /* PUSH-BASED fragmented, TIME upstream: samples taken from the adapter and
    * not pushed yet, in decode-time order */
   GQueue held_samples;
