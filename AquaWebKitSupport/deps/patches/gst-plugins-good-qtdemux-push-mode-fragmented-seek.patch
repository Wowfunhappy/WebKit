   /* NOTE @stream ignored */
 
@@ -4794,6 +4838,11 @@
     if (stream->n_samples_moof && stream->duration_moof)
       stream->new_caps = TRUE;
 
+    if (stream->n_samples_moof)
+      fragment_dts = MIN (fragment_dts, QTSTREAMTIME_TO_GSTTIME (stream,
