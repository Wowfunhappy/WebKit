Subject: closedcaption: make native overlay rendering an optional default feature

The caption parsers and text converters do not need a native rendering backend.
Keep the full upstream plugin as the default; embedders that render converted
WebVTT themselves can disable only the CEA608/CEA708 overlay elements and their
Cairo/Pango helpers. Conversion algorithms and registration names are unchanged.

--- a/video/closedcaption/Cargo.toml
+++ b/video/closedcaption/Cargo.toml
@@ -14,9 +14,9 @@
 uuid = { version = "1.0", features = ["v4"] }
 chrono = "0.4.23"
 atomic_refcell = "0.1"
-cairo-rs.workspace = true
-pango.workspace = true
-pangocairo.workspace = true
+cairo-rs = { workspace = true, optional = true }
+pango = { workspace = true, optional = true }
+pangocairo = { workspace = true, optional = true }
 byteorder = "1"
 serde = { version = "1.0", features = ["derive"] }
 serde_json = { version = "1.0", features = ["raw_value"] }
@@ -48,6 +48,8 @@
 gst-plugin-version-helper.workspace = true
 
 [features]
+default = ["rendering"]
+rendering = ["dep:cairo-rs", "dep:pango", "dep:pangocairo"]
 # We already use 1.16 which is new enough for static build
