# Deselecting a text track pushes EOS on its output, and a text stream that ended waits in the stream
# synchronizer until the other streams end, holding its pad's stream lock. Releasing that pad deactivates
# it, which waits for the lock, so playbin3 removing the text output of a running pipeline hangs. A flush
# wakes the synchronizer. remove_combiner() releases the combiner's pads, and forgets them on their decoded
# pads so that a removal does not release them again. decodebin3 can reuse a decoded pad that outlived the
# combiner without adding it again, so a new combiner links the decoded pads of its type.
--- a/gst/playback/gstplaysink.c
+++ b/gst/playback/gstplaysink.c
@@ -4720,6 +4720,7 @@
 void
 gst_play_sink_release_pad (GstPlaySink * playsink, GstPad * pad)
 {
+  GstPad *text_target = NULL;
   GstPad **res = NULL;
   gboolean untarget = TRUE;
 
@@ -4749,7 +4750,18 @@
 
   if (*res) {
     GST_DEBUG_OBJECT (playsink, "deactivate pad %" GST_PTR_FORMAT, *res);
+    /* A text stream that ended waits in the stream synchronizer, holding its
+     * stream lock, until the other streams end or a flush arrives. The text
+     * chain stays for a later stream, so the flush also ends behind the pad */
+    if (pad == playsink->text_pad)
+      text_target = gst_ghost_pad_get_target (GST_GHOST_PAD_CAST (*res));
+    if (text_target)
+      gst_pad_send_event (*res, gst_event_new_flush_start ());
     gst_pad_set_active (*res, FALSE);
+    if (text_target) {
+      gst_pad_send_event (text_target, gst_event_new_flush_stop (FALSE));
+      gst_object_unref (text_target);
+    }
     if (untarget) {
       GST_DEBUG_OBJECT (playsink, "untargeting pad %" GST_PTR_FORMAT, *res);
       gst_ghost_pad_set_target (GST_GHOST_PAD_CAST (*res), NULL);
