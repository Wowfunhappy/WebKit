+// An explicit TLS 1.3 cipher order for the ClientHello.
+static bool check_tls13_cipher_ids(Span<const uint16_t> ids) {
+  for (uint16_t id : ids) {
+    const SSL_CIPHER *cipher = SSL_get_cipher_by_value(id);
+    if (cipher == nullptr ||
+        SSL_CIPHER_get_min_version(cipher) < TLS1_3_VERSION) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_NO_CIPHER_MATCH);
+      return false;
+    }
+  }
+  return true;
+}
+
+int SSL_CTX_set1_tls13_cipher_ids(SSL_CTX *ctx, const uint16_t *cipher_ids,
+                                  size_t num_cipher_ids) {
+  auto span = Span(cipher_ids, num_cipher_ids);
+  return check_tls13_cipher_ids(span) && FromOpaque(ctx)->tls13_cipher_list.CopyFrom(span);
+}
