# The UI process's router delivering a message, with the bytes it carries, to one frame's context of one
# Safari 7 extension, webRequest.handlerBehaviorChanged emptying the memory cache, whose hits never reach
# webRequest, the mimeHandler viewers extensions supply, as a JSON array of
# {mimeType, extensionKey, handlerURL, canEmbed}, whether one page prints backgrounds, for tabs.saveAsPDF, and
# the execution context of the main world of a page's frame, found by its URL, for devtools.inspectedWindow.eval,
# the invalidation of an extension page whose extension Safari disabled or reloaded, the files of each extension
# web pages can and cannot use, as a JSON array of {root, accessible, inaccessible}, and the end of the world
# scripting.executeScript made for an extension with no content scripts.
[
    DispatchedFrom=UI,
    DispatchedTo=WebContent,
    ExceptionForEnabledBy
]
messages -> LegacyExtensionContent {
    Deliver(WebCore::FrameIdentifier frameID, std::optional<WebCore::ScriptExecutionContextIdentifier> documentID, String extensionKey, String message, IPC::SharedBufferReference data)
    EvictMemoryCache()
    SetMimeHandlers(String handlers)
    SetResourcePolicies(String policies)
    RemoveScriptingWorld(String extensionKey)
    SetPrintsBackgrounds(WebCore::PageIdentifier pageID, bool printsBackgrounds)
    InvalidateExtensionPage(WebCore::FrameIdentifier frameID, WebCore::ScriptExecutionContextIdentifier documentID)
}
