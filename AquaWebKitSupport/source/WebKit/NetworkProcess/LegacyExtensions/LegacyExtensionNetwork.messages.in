# The webRequest events Safari 7 extensions listen to, the extraInfoSpec options their listeners ask for
# ("<event>:<option>"), and the filter of each blocking listener: a JSON object mapping an event name to an
# array of {extension, urls, types, tabId}. The StreamFilters an extension attaches to a load, by the load's
# request identifier, within the extension's website access (as WebsiteAccess JSON), and what it does with
# them; `dispatched` counts the data events the extension has dispatched. The privacy API's settings.
[
    DispatchedFrom=UI,
    DispatchedTo=Networking,
    ExceptionForEnabledBy
]
messages -> LegacyExtensionNetwork {
    SetListeners(Vector<String> observedEvents, Vector<String> listenerOptions, String blockingListeners)
    CreateResponseFilter(uint64_t filterID, uint64_t requestIdentifier, String extensionKey, String websiteAccess)
    WriteResponseFilter(uint64_t filterID, IPC::SharedBufferReference data, uint64_t dispatched)
    CloseResponseFilter(uint64_t filterID)
    DisconnectResponseFilter(uint64_t filterID, uint64_t dispatched)
    SuspendResponseFilter(uint64_t filterID)
    ResumeResponseFilter(uint64_t filterID)
    SetPrivacySettings(bool networkPredictionEnabled, bool hyperlinkAuditingEnabled)
}
